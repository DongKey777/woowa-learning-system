{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Concept Entity v2",
  "type": "object",
  "required": ["id", "title", "category", "level", "summary", "body_markdown", "metadata"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z-]+/[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "type": "string",
      "enum": [
        "algorithm",
        "data-structure",
        "database",
        "design-pattern",
        "language",
        "network",
        "operating-system",
        "security",
        "software-engineering",
        "spring",
        "system-design"
      ]
    },
    "level": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "body_markdown": {
      "type": "string",
      "minLength": 10
    },
    "aliases": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 50
    },
    "expected_queries": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 100
    },
    "symptoms": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 50
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prerequisites": {"type": "array", "items": {"type": "string"}},
        "next_docs": {"type": "array", "items": {"type": "string"}},
        "confusable_with": {"type": "array", "items": {"type": "string"}},
        "forbidden_for_queries": {"type": "array", "items": {"type": "string"}}
      }
    },
    "learner_query_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "match_count", "added_at"],
        "additionalProperties": false,
        "properties": {
          "pattern": {"type": "string"},
          "match_count": {"type": "integer"},
          "added_at": {"type": "string", "format": "date"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["schema_version", "created_at", "last_modified"],
      "additionalProperties": true,
      "properties": {
        "schema_version": {"type": "string", "const": "v2"},
        "created_at": {"type": "string", "format": "date"},
        "last_modified": {"type": "string", "format": "date"},
        "legacy_path": {"type": "string"},
        "revision_history": {"type": "array"}
      }
    }
  }
}
