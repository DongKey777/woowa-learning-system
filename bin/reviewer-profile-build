#!/usr/bin/env python3
"""bin/reviewer-profile-build — F3 / family C builder (repo-scoped).

Reviewer-style surface: given a repo + a reviewer login (or auto-resolved top
mentor on the learner's own PRs), summarize that reviewer's habits — root
review-comment volume, recurring topics, hotspot files, review-state mix, and a
few sample threads. Reads state/repos/<repo>/archive/prs.sqlite3 and writes
state/repos/<repo>/reviewer_profile.json (loaded in mode reviewer_profile).
See mission/reviewer_profile.py for the analysis contract.

Usage:
  bin/reviewer-profile-build --repo spring-roomescape-member
  bin/reviewer-profile-build --repo spring-roomescape-waiting --reviewer-login jurlring
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.reviewer_profile import analyze, save_reviewer_profile  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--reviewer-login", default=None,
                        help="default: auto-resolve top mentor on learner PRs")
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = args.learner_login
    if learner is None:
        learner = resolve_learner_login(args.state_root)

    report = analyze(args.repo, reviewer_login=args.reviewer_login,
                     learner_login=learner, state_root=args.state_root)
    out = save_reviewer_profile(report, args.state_root)
    if args.silent:
        return 0
    print(json.dumps({"repo": report["repo"],
                      "reviewer_login": report["reviewer_login"],
                      "status": report["status"],
                      "counts": report["counts"]}, ensure_ascii=False))
    print(f"  wrote: {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
