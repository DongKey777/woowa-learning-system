#!/usr/bin/env python3
"""bin/learn-learning-path-build — F2 / family D builder (cross-repo).

Learning-path planning: from the learner's mastery state (proficient+ concepts)
plus the concept prerequisite/next/confusable graph, recommend which concepts to
learn next and in what order. Reads corpus/concept_graph.json +
state/learner/mastery_graph.sqlite and writes state/learner/learning_path.json
(loaded in mode learning_path).

Cross-repo builder: learner-scoped, NO --repo arg. Run after mastery updates.
See mission/learning_path.py for the analysis contract.

Usage:
  bin/learn-learning-path-build [--learner-login DongKey777]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.learning_path import analyze, save_learning_path  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    report = analyze(learner, args.state_root)
    save_learning_path(report, args.state_root)
    if args.silent:
        return 0
    print(json.dumps({
        "learner_login": report["learner_login"],
        "status": report["status"],
        "mastery_distribution": report["mastery_distribution"],
        "counts": report["counts"],
    }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
