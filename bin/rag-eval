#!/usr/bin/env python3
"""bin/rag-eval — thin wrapper over tests/benchmarks/rag_quality_regression.py
(Phase W10).
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
TARGET = REPO_ROOT / "tests" / "benchmarks" / "rag_quality_regression.py"


def main() -> int:
    env = {**os.environ, "WOOWA_SESSION_MODE": "development"}
    return subprocess.call([sys.executable, str(TARGET)], cwd=REPO_ROOT, env=env)


if __name__ == "__main__":
    raise SystemExit(main())
