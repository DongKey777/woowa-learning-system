#!/usr/bin/env python3
"""bin/learn-thread-recon-build — family G builder (repo-scoped).

Review-thread reconstruction: stitches the learner's PR review comments back
into reply-chains (root → ordered replies). Reads
state/repos/<repo>/archive/prs.sqlite3 (table
pull_request_review_comments_current) and writes
state/repos/<repo>/thread_recon.json (loaded in mode thread_recon). See
mission/thread_recon.py for the analysis contract.

Usage:
  bin/learn-thread-recon-build --repo spring-roomescape-waiting [--learner-login DongKey777]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.thread_recon import analyze_repo, save_thread_recon  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    report = analyze_repo(args.repo, learner, args.state_root)
    out = save_thread_recon(report, args.state_root)
    if args.silent:
        return 0
    print(json.dumps({"repo": report["repo"], "status": report["status"],
                      "counts": report["counts"]}, ensure_ascii=False))
    print(f"  wrote: {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
