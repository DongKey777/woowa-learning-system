#!/usr/bin/env python3
"""bin/assess-learner-state — snapshot learner mission repo state (Phase T5).

paradigm-v2 v1: pure local — git CLI + SQLite archive. No gh API call
(deferred to Phase U). Hard 60s budget.

CLI: bin/assess-learner-state --repo R --path missions/<r>
                              [--learner-login L] [--budget-secs 60]
                              [--target-pr N] [--silent]
Output: state/repos/<r>/contexts/learner-state.json
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.learner_state import assess_learner_state  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--path", type=Path, required=True,
                        help="missions/<repo>/ path")
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--budget-secs", type=float, default=60.0)
    parser.add_argument("--target-pr", type=int, default=None)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    if not args.path.exists():
        print(f"ERROR: mission path not found: {args.path}", file=sys.stderr)
        return 2

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    payload = assess_learner_state(
        repo=args.repo, mission_path=args.path,
        state_root=args.state_root, learner_login=learner,
        budget_secs=args.budget_secs, target_pr_number=args.target_pr,
    )
    if not args.silent:
        print(json.dumps({
            "repo": payload["repo"],
            "head_branch": payload.get("head_branch"),
            "working_copy_clean": payload.get("working_copy", {}).get("clean"),
            "prs_n": len(payload.get("prs", [])),
            "target_pr": (payload.get("target_pr") or {}).get("number"),
            "threads_n": (payload.get("target_pr") or {}).get("threads_total"),
            "elapsed_s": payload["elapsed_s"],
            "coverage": payload["coverage"],
            "out_path": payload["out_path"],
        }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
