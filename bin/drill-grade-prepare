#!/usr/bin/env python3
"""bin/drill-grade-prepare — build AI session prompt to grade a drill
answer (Phase X2). Thin wrapper around core.drill.score_pending_answer
mechanics, but emits prompt for AI session preview without writing.

CLI: bin/drill-grade-prepare --pending-file P [--answer A]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--pending-file", type=Path, required=True)
    parser.add_argument("--answer", default=None)
    args = parser.parse_args(argv)

    if not args.pending_file.exists():
        print(f"ERROR: pending file missing: {args.pending_file}", file=sys.stderr)
        return 2
    offer = json.loads(args.pending_file.read_text(encoding="utf-8"))

    prompt = (
        f"# Drill grading prompt\n\n"
        f"Concept: {offer.get('concept_id')}\n"
        f"Question: {offer.get('question')}\n"
        f"Expected terms: {offer.get('expected_terms', [])}\n\n"
        f"Learner answer:\n{args.answer or '<not provided>'}\n\n"
        "Score 4 dimensions (each 0-10):\n"
        "- accuracy: terms matched / depth of concept ownership\n"
        "- depth: did the answer go beyond definition?\n"
        "- practicality: code example or concrete scenario included?\n"
        "- completeness: 왜/언제/어떻게 structure present?\n\n"
        "Total = weighted sum (acc 0.40, depth 0.25, prac 0.20, comp 0.15) / 10.\n"
        "Bands: <0.45 weak, 0.45-0.65 ok, 0.65-0.80 good, ≥0.80 mastered.\n\n"
        "Output: `total: <0..1>, level: <band>, improvement_notes: <1줄>`"
    )
    print(json.dumps({
        "concept_id": offer.get("concept_id"),
        "question": offer.get("question"),
        "expected_terms": offer.get("expected_terms", []),
        "answer_provided": args.answer is not None,
        "ai_grading_prompt": prompt,
    }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
