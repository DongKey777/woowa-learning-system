#!/usr/bin/env python3
"""bin/learn-cohort-build — family F builder (repo-scoped).

Learner-vs-cohort comparison on the same mission: cohort distribution medians
(PR size, changed files, commits, reviews received, review rounds) plus the
learner's own PRs and a per-metric percentile rank for the learner's most-recent
PR. Reads state/repos/<repo>/archive/prs.sqlite3 (tables pull_requests_current +
pull_request_reviews_current) and writes state/repos/<repo>/cohort.json (loaded
in mode cohort). See mission/cohort.py for the analysis contract.

Usage:
  bin/learn-cohort-build --repo spring-roomescape-member [--learner-login DongKey777]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.cohort import analyze_repo, save_cohort  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    report = analyze_repo(args.repo, learner, args.state_root)
    out = save_cohort(report, args.state_root)
    if args.silent:
        return 0
    print(json.dumps({"repo": report["repo"], "status": report["status"],
                      "cohort": report["cohort"], "counts": report["counts"]},
                     ensure_ascii=False))
    print(f"  wrote: {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
