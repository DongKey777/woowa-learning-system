#!/usr/bin/env python3
"""bin/compare — direct PR-to-PR comparison (Phase V7).

CLI: bin/compare --repo R --pr-a A --pr-b B [--silent]
Reuses paradigm-v2 peer-pr precise compare via daemon path.
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--pr-a", type=int, required=True,
                        help="learner PR number (anchor side)")
    parser.add_argument("--pr-b", type=int, required=True,
                        help="peer PR number (candidate side)")
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    prompt = (f"PR #{args.pr_a}와 PR #{args.pr_b} 정밀 비교해줘. "
              f"다른 점, 학습 포인트, 멘토 의견 차이를 정리해.")
    cmd = [sys.executable, str(REPO_ROOT / "bin" / "coach-run"),
            "--repo", args.repo, "--prompt", prompt]
    if args.silent:
        cmd.append("--silent")
    return subprocess.call(cmd)


if __name__ == "__main__":
    raise SystemExit(main())
