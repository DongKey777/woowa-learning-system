#!/usr/bin/env python3
"""bin/learn-evidence-sync — emit pr_merge / mentor_accept evidence from the PR
archive into Bloom mastery (Phase F0-e).

Fixes the starved mastery loop (all concepts stuck at `attempted`): the
ingest_* paths existed but were only test-wired. Reads the per-repo archive +
mission_patterns + review_anchors and promotes the learner's mentor-accepted,
merged-PR concepts. Idempotent (re-runnable) via dedup_key.

CLI: bin/learn-evidence-sync --repo R [--learner-login L] [--silent]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.evidence_sync import sync_repo  # noqa: E402
from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    report = sync_repo(args.repo, learner_login=learner, state_root=args.state_root)

    if not args.silent:
        print(json.dumps(report, ensure_ascii=False, indent=2))
    return 0 if report["status"] in ("ok", "missing_archive") else 1


if __name__ == "__main__":
    raise SystemExit(main())
