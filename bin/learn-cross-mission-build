#!/usr/bin/env python3
"""bin/learn-cross-mission-build — F2 / family L builder (cross-repo).

Cross-mission learning analytics: concept carryover between missions, mentor
signals that recur across missions, and relative mission difficulty. Reads all
of the learner's missions at once (state/learner/mastery_graph.sqlite +
state/repos/*/mission_patterns.json + archives) and writes
state/learner/cross_mission.json (loaded in mode cross_mission).

Cross-repo builder: run once after per-repo syncs, NOT inside the per-repo
sync-prs refresh loop. See mission/cross_mission.py for the analysis contract.

Usage:
  bin/learn-cross-mission-build [--learner-login DongKey777]
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.cross_mission import analyze, save_cross_mission  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    report = analyze(learner, args.state_root)
    out = save_cross_mission(report, args.state_root)
    if args.silent:
        return 0
    print(f"learner={learner} status={report['status']} "
          f"missions={len(report['repos_analyzed'])}")
    print(f"  order: {' -> '.join(report['repos_analyzed'])}")
    print(f"  carryover={len(report['carryover'])} "
          f"recurring={len(report['recurring_across_missions'])} "
          f"difficulty_rows={len(report['difficulty'])}")
    for c in report["carryover"][:8]:
        print(f"    · {c['concept_id']}: {c['proven_in']} -> {c['reused_in']}")
    print(f"  wrote: {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
