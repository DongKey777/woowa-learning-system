#!/usr/bin/env python3
"""bin/learn-meta-analytics-build — F2 / family E builder (cross-repo).

Meta-learning analytics: which CS concepts I keep re-asking (sticky concepts),
what KINDS of questions I ask (router-mode mix), answer-quality flag trends, and
a Bloom mastery snapshot. Reads the learner's whole ask history at once
(state/learner/{history.jsonl,response-quality.jsonl} + core.mastery) and writes
state/learner/meta_analytics.json (loaded in mode meta_analytics).

Cross-repo builder: run once over the full history, NOT inside the per-repo
sync-prs refresh loop. See mission/meta_analytics.py for the analysis contract.

Usage:
  bin/learn-meta-analytics-build [--learner-login DongKey777]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.meta_analytics import analyze, save_meta_analytics  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--learner-login", default=None,
                        help="default: DongKey777")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = args.learner_login or "DongKey777"
    report = analyze(learner, args.state_root)
    out = save_meta_analytics(report, args.state_root)
    if args.silent:
        return 0
    print(json.dumps({
        "status": report["status"],
        "counts": report["counts"],
        "top_repeated_concepts": report["repeated_concepts"][:3],
    }, ensure_ascii=False, indent=2))
    print(f"wrote: {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
