#!/usr/bin/env python3
"""bin/capture-repair — replay repairable response capture failures."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.response_capture import drain_repair_queue, repair_queue_path  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--last", type=int, default=50)
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--learner-id", default=None)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    args = parser.parse_args(argv)

    learner_id = resolve_learner_login(args.state_root, explicit=args.learner_id)
    summary = drain_repair_queue(
        state_root=args.state_root,
        learner_id=learner_id,
        limit=args.last,
        apply=args.apply,
    )

    print(json.dumps({
        "queue_path": str(repair_queue_path(args.state_root)),
        "scanned_n": summary["scanned"],
        "repairable_n": summary["repairable"],
        "unrecoverable_n": summary["unrecoverable"],
        "applied_n": summary["applied"],
    }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
