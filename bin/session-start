#!/usr/bin/env python3
"""bin/session-start — orchestrator wrapping assess → profile-recompute → ask
(Phase T7).

Cold path: ≤50s (assess 45s + profile ~100ms + ask ~30ms)
Warm path: ≤800ms (skip assess + profile, just ask)

CLI: bin/session-start --repo R --prompt P [--path missions/<r>]
                       [--context auto|coach|drill] [--force-refresh] [--silent]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.session import start_session  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", default=None)
    parser.add_argument("--prompt", required=True)
    parser.add_argument("--path", type=Path, default=None,
                        help="missions/<repo>/ — required for cold-path assess")
    parser.add_argument("--context", default="auto",
                        choices=("auto", "coach", "drill"))
    parser.add_argument("--learner-id", default="default")
    parser.add_argument("--learner-login", default="DongKey777")
    parser.add_argument("--force-refresh", action="store_true")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    result = start_session(
        repo=args.repo, prompt=args.prompt, mission_path=args.path,
        learner_id=args.learner_id, learner_login=args.learner_login,
        state_root=args.state_root, context=args.context,
        force_refresh=args.force_refresh,
    )
    if not args.silent:
        print(json.dumps({
            "boot_type": result["boot_type"],
            "assess_ran": result["assess_ran"],
            "profile_ran": result["profile_ran"],
            "ask_ok": result["ask_ok"],
            "ask_latency_ms": result["ask_latency_ms"],
            "mode": result["mode"],
            "event_id": result["event_id"],
            "errors": result["errors"],
            "markdown_preview": result["markdown"][:200],
        }, ensure_ascii=False, indent=2))
    return 0 if result["ask_ok"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
