#!/usr/bin/env python3
"""bin/capture-response — non-blocking hook response capture.

Reads a Claude/Codex/Gemini hook JSON payload, extracts the final assistant
answer, and records full response-quality telemetry against the latest pending
rag_ask capture. Capture failures are queued for repair and do not block the
learning answer flow.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.response_capture import capture_from_hook_payload  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def _read_hook_json(path: str) -> dict:
    raw = sys.stdin.read() if path == "-" else Path(path).read_text(encoding="utf-8")
    if not raw.strip():
        return {}
    data = json.loads(raw)
    if not isinstance(data, dict):
        raise ValueError("hook payload must be a JSON object")
    return data


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--hook-json", default="-",
                        help="hook JSON path or '-' for stdin")
    parser.add_argument("--client", default="auto",
                        choices=("auto", "claude", "codex", "gemini"))
    parser.add_argument("--learner-id", default=None)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true",
                        help="print {} only for hook-friendly stdout")
    args = parser.parse_args(argv)

    try:
        payload = _read_hook_json(args.hook_json)
        learner_id = resolve_learner_login(args.state_root, explicit=args.learner_id)
        result = capture_from_hook_payload(
            payload,
            client=args.client,
            state_root=args.state_root,
            learner_id=learner_id,
        )
    except Exception as exc:  # noqa: BLE001 - hook must not break learning flow
        result = {"ok": False, "reason": type(exc).__name__, "error": str(exc)[:200]}

    print("{}" if args.silent else json.dumps(result, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
