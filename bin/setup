#!/bin/sh
# bin/setup — one-shot environment bootstrap for woowa-learning-system.
#
# Creates a repo-local .venv and installs the runtime deps into it. macOS
# Homebrew / Debian system Python is PEP 668 "externally-managed" and refuses
# `pip install`, so a venv is the friction-free path: no --break-system-packages,
# no system pollution. The bin entry points re-exec into .venv automatically
# (see core/_venv.py), so nothing else needs to know the venv exists.
#
# Idempotent — re-running upgrades in place.
#
# Usage:
#   bin/setup          # runtime deps (learner)
#   bin/setup --dev    # + pytest  (Mode B / system development)
set -eu

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"
VENV_DIR="$REPO_ROOT/.venv"
VENV_PY="$VENV_DIR/bin/python"

WANT_DEV=0
for arg in "$@"; do
  case "$arg" in
    --dev) WANT_DEV=1 ;;
    -h|--help)
      echo "Usage: bin/setup [--dev]"
      exit 0 ;;
    *)
      echo "알 수 없는 옵션: $arg (사용법: bin/setup [--dev])" >&2
      exit 2 ;;
  esac
done

# 1. Python 3.10+ 확인
PY_BIN="${PYTHON:-python3}"
if ! command -v "$PY_BIN" >/dev/null 2>&1; then
  echo "python3 를 찾을 수 없어. Python 3.10+ 를 먼저 설치해줘 (macOS: brew install python@3.12, Ubuntu: sudo apt install python3.12)." >&2
  exit 1
fi
if ! "$PY_BIN" -c 'import sys; sys.exit(0 if sys.version_info[:2] >= (3, 10) else 1)'; then
  VER="$("$PY_BIN" -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
  echo "Python 3.10+ 가 필요해 (현재 $VER). macOS: brew install python@3.12" >&2
  exit 1
fi

# 2. .venv 생성 (없을 때만)
if [ ! -x "$VENV_PY" ]; then
  echo "가상환경 만드는 중 (.venv)…"
  "$PY_BIN" -m venv "$VENV_DIR"
fi

# 3. pip 최신화 + 의존성 설치
"$VENV_PY" -m pip install --quiet --upgrade pip
if [ "$WANT_DEV" = "1" ]; then
  echo "의존성 설치 중 (dev 포함, BGE-M3/torch 다운로드로 수 분 걸릴 수 있어)…"
  "$VENV_PY" -m pip install -e ".[dev]"
else
  echo "의존성 설치 중 (BGE-M3/torch 다운로드로 수 분 걸릴 수 있어)…"
  "$VENV_PY" -m pip install -e .
fi

echo "완료. bin/ 명령들이 이제 .venv 를 자동으로 사용해."
