#!/usr/bin/env python3
"""bin/pr-diff-evolution-build — F1 / family H builder.

Reconstructs how the learner's PR evolved across mentor review rounds from
state/repos/<repo>/archive/prs.sqlite3 + the missions/<repo> git clone, and
writes state/repos/<repo>/pr_diff_evolution.json (loaded in mode
pr_diff_evolution). See mission/diff_evolution.py for the analysis contract.

Usage:
  bin/pr-diff-evolution-build --repo spring-roomescape-member [--learner-login DongKey777]
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.diff_evolution import analyze_repo, save_evolution  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--mission-root", type=Path, default=None,
                        help="git clone root (default: state-root's sibling missions/)")
    parser.add_argument("--silent", action="store_true",
                        help="suppress stdout report (used by sync-prs chain)")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    report = analyze_repo(args.repo, learner, args.state_root,
                          mission_root=args.mission_root)
    if report["status"] == "missing_archive":
        print(f"ERROR: archive not found for {args.repo}", file=sys.stderr)
        return 2
    out = save_evolution(report, args.repo, args.state_root)
    if args.silent:
        return 0
    print(f"repo={report['repo']} learner={learner} clone={report['clone_available']}")
    for pr in report["prs"]:
        print(f"  PR#{pr['number']} merged={pr['merged']} rounds={pr['round_count']} "
              f"review_to_fix={len(pr['review_to_fix'])} hotspots={len(pr['hotspots'])} "
              f"smells={len(pr['smells'])}")
    print(f"  wrote: {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
