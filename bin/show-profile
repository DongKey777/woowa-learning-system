#!/usr/bin/env python3
"""bin/show-profile — pretty-print global + per-repo profile (Phase X8)."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", default=None)
    parser.add_argument("--learner-id", default=None)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    args = parser.parse_args(argv)
    resolve_learner_login(args.state_root, explicit=args.learner_id)

    out = {}
    global_p = args.state_root / "learner" / "profile.json"
    if global_p.exists():
        out["global"] = json.loads(global_p.read_text(encoding="utf-8"))
    if args.repo:
        repo_p = args.state_root / "repos" / args.repo / "profile.json"
        if repo_p.exists():
            out["repo"] = json.loads(repo_p.read_text(encoding="utf-8"))
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
