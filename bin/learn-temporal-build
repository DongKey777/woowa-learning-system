#!/usr/bin/env python3
"""bin/learn-temporal-build — family I builder (repo-scoped).

PR iteration-latency / cadence: per learner PR it computes time-to-first-review,
review-round gaps, time-to-merge, and stalls (gaps > 72h). Reads
state/repos/<repo>/archive/prs.sqlite3 (tables pull_requests_current,
pull_request_reviews_current, pull_request_review_comments_current) and writes
state/repos/<repo>/temporal.json (loaded in mode temporal). See
mission/temporal.py for the analysis contract.

Usage:
  bin/learn-temporal-build --repo spring-roomescape-waiting [--learner-login DongKey777]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.temporal import analyze_repo, save_temporal  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    report = analyze_repo(args.repo, learner, args.state_root)
    out = save_temporal(report, args.state_root)
    if args.silent:
        return 0
    print(json.dumps({"repo": report["repo"], "status": report["status"],
                      "aggregate": report["aggregate"],
                      "counts": report["counts"]},
                     ensure_ascii=False))
    print(f"  wrote: {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
