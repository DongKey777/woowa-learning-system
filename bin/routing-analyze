#!/usr/bin/env python3
"""bin/routing-analyze — analyze rag_ask router decisions (Phase W3)."""
from __future__ import annotations

import argparse
import json
import sys
from collections import Counter
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from scripts.mining.jsonl_iter import iter_jsonl  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mode-filter", default=None,
                        help="only mode == X events")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--top-n", type=int, default=10)
    args = parser.parse_args(argv)

    path = args.state_root / "learner" / "history.jsonl"
    router_modes: Counter = Counter()
    router_reasons: Counter = Counter()
    repos: Counter = Counter()
    total = 0
    exclude_modes = () if args.mode_filter is not None else ("development", "test")
    for ev in iter_jsonl(
        path,
        event_type="rag_ask",
        mode=args.mode_filter,
        exclude_modes=exclude_modes,
    ):
        total += 1
        payload = ev.get("payload") or {}
        rm = payload.get("router_mode", "?")
        router_modes[rm] += 1
        if rm != "?":
            reason = (payload.get("router_reason") or "?")[:60]
            router_reasons[f"{rm}: {reason}"] += 1
        if payload.get("repo"):
            repos[payload["repo"]] += 1

    print(json.dumps({
        "history_path": str(path),
        "rag_ask_total": total,
        "router_modes": dict(router_modes),
        "top_router_reasons": [{"reason": r, "n": n}
                                 for r, n in router_reasons.most_common(args.top_n)],
        "top_repos": [{"repo": r, "n": n}
                       for r, n in repos.most_common(args.top_n)],
    }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
