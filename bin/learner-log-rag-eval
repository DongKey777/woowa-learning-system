#!/usr/bin/env python3
"""bin/learner-log-rag-eval — replay learner rag_ask history through current
RAG (Phase W12). Reports top_concept_id drift vs historical record.
"""
from __future__ import annotations

import argparse
import json
import socket
import sys
import time
from collections import Counter
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from scripts.mining.jsonl_iter import iter_jsonl  # noqa: E402


def _daemon_search(query, state_root):
    sp = state_root / "rag-daemon.sock"
    if not sp.exists():
        return []
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(30)
    s.connect(str(sp))
    s.sendall((json.dumps({"action": "search", "query": query, "top_k": 5}) + "\n").encode())
    s.shutdown(socket.SHUT_WR)
    data = b""
    while True:
        c = s.recv(65536)
        if not c:
            break
        data += c
    s.close()
    return json.loads(data.decode().strip()).get("hits", [])


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--since", default=None, help="ISO ts lower bound")
    parser.add_argument("--limit", type=int, default=50,
                        help="cap audited queries (default 50)")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    args = parser.parse_args(argv)

    since_ts = None
    if args.since:
        import datetime as dt
        since_ts = dt.datetime.fromisoformat(args.since.replace("Z", "+00:00")).timestamp()

    path = args.state_root / "learner" / "history.jsonl"
    events = [ev for ev in iter_jsonl(path, event_type="rag_ask", since_ts=since_ts)
              if (ev.get("payload") or {}).get("prompt")
              and (ev.get("payload") or {}).get("top_concept_ids")][-args.limit:]

    drift_n = 0
    same_top1 = 0
    transitions: Counter = Counter()
    examples = []
    for ev in events:
        payload = ev["payload"]
        prompt = payload["prompt"]
        historical_top1 = (payload.get("top_concept_ids") or [None])[0]
        hits = _daemon_search(prompt, args.state_root)
        new_top1 = hits[0].get("concept_id") if hits else None
        if historical_top1 == new_top1:
            same_top1 += 1
        else:
            drift_n += 1
            transitions[f"{historical_top1} → {new_top1}"] += 1
            if len(examples) < 10:
                examples.append({"prompt": prompt[:60],
                                  "historical_top1": historical_top1,
                                  "new_top1": new_top1})

    print(json.dumps({
        "events_audited": len(events),
        "same_top1": same_top1,
        "drift_n": drift_n,
        "drift_pct": round(drift_n / max(1, len(events)) * 100, 1),
        "top_transitions": dict(transitions.most_common(10)),
        "examples": examples,
    }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
