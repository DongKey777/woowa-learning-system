#!/usr/bin/env python3
"""bin/learn-feedback — record explicit learner feedback (Phase X3).

CLI: bin/learn-feedback --signal helpful|not_helpful|unclear
                       [--hit DOC]+ [--note N] [--repo R] [--source-event-id E]
                       [--silent]
Appends to state/learner/feedback.jsonl (mined by W1 bin/feedback-mine).
"""
from __future__ import annotations

import argparse
import hashlib
import json
import sys
import time
import uuid
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--signal", required=True,
                        choices=("helpful", "not_helpful", "unclear"))
    parser.add_argument("--hit", action="append", default=[],
                        help="doc path(s) that informed the rating")
    parser.add_argument("--note", default=None)
    parser.add_argument("--source-event-id", default=None)
    parser.add_argument("--turn-id", default=None)
    parser.add_argument("--repo", default=None)
    parser.add_argument("--learner-id", default=None)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner_id = resolve_learner_login(args.state_root, explicit=args.learner_id)

    log = args.state_root / "learner" / "feedback.jsonl"
    log.parent.mkdir(parents=True, exist_ok=True)
    row = {
        "feedback_id": f"fb-{int(time.time() * 1000)}-{uuid.uuid4().hex[:6]}",
        "logged_at": time.time(),
        "learner_id": learner_id,
        "repo": args.repo,
        "signal": args.signal,
        "doc_paths": args.hit,
        "note": args.note,
        "source_event_id": args.source_event_id,
        "turn_id": args.turn_id,
    }
    with log.open("a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")
    if not args.silent:
        print(json.dumps({"feedback_id": row["feedback_id"],
                           "signal": row["signal"], "hits_n": len(args.hit)},
                          ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
