#!/usr/bin/env python3
"""bin/rag-route-fallback — expose router internals for low-confidence
prompts so AI session can disambiguate (Phase V11).

CLI: bin/rag-route-fallback --prompt P [--repo R]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.router import route  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prompt", required=True)
    parser.add_argument("--repo", default=None)
    parser.add_argument("--threshold", type=float, default=0.7,
                        help="confidence threshold for 'low-confidence' tag")
    args = parser.parse_args(argv)

    decision = route(args.prompt, repo=args.repo)

    candidate_modes = ["cs_qa", "coaching", "tool_only", "retro",
                        "drill", "self_assess", "f11_anchor"]
    other_modes = [m for m in candidate_modes if m != decision.mode]

    ai_disambig = (
        f"Router decision: mode={decision.mode} confidence={decision.confidence}\n"
        f"Reason: {decision.reason}\n"
        f"Alternative modes (for AI to consider): {other_modes}\n\n"
        f"Prompt: {args.prompt}\n"
        f"Repo: {args.repo}\n\n"
        "If confidence is low (<0.7), pick the most appropriate mode AND "
        "explain why. Output: `chosen_mode: <m>, reason: <1줄>`"
    )

    payload = {
        "prompt": args.prompt,
        "repo": args.repo,
        "decision": {
            "mode": decision.mode,
            "confidence": decision.confidence,
            "reason": decision.reason,
            "personas": decision.personas,
            "budget_tokens": decision.budget_tokens,
            "lazy_artifacts": decision.lazy_artifacts,
        },
        "low_confidence": decision.confidence < args.threshold,
        "candidate_modes": candidate_modes,
        "ai_disambig_prompt": ai_disambig,
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
