#!/usr/bin/env python3
"""bin/learn-event — append a learner event to history.jsonl + optional profile signals.

The AI session calls this AFTER drafting the learner-facing answer:

  bin/learn-event \\
      --event-type rag_ask --mode learning --prompt "..." --answer "..." \\
      --citation spring/bean --citation spring/component

When --add-mastered / --add-uncertain are passed, profile.json is updated
(LearnerProfile recompute is the AI session's job, not this CLI).
"""
from __future__ import annotations

import argparse
import sys
import time
import uuid
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT, append_history_event, load_profile, save_profile  # noqa: E402
from core.feedback import record_turn  # noqa: E402
from core.identity import resolve_learner_login  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--event-type", required=True,
                        choices=("rag_ask", "coach_run", "drill_answer", "self_assessment",
                                 "code_attempt", "test_result", "response_quality"))
    parser.add_argument("--mode", default="learning",
                        choices=("learning", "development", "test"))
    parser.add_argument("--learner-id", default=None)
    parser.add_argument("--repo", default=None)
    parser.add_argument("--prompt", default=None)
    parser.add_argument("--answer", default=None,
                        help="drill_answer: 자유 텍스트면 score_pending_answer로 자동 채점")
    parser.add_argument("--citation", action="append", default=None)
    parser.add_argument("--quality-flag", action="append", default=None)
    parser.add_argument("--add-mastered", action="append", default=None)
    parser.add_argument("--add-uncertain", action="append", default=None)
    parser.add_argument("--drill-concept", default=None,
                        help="concept_id graded by drill (with --drill-score)")
    parser.add_argument("--drill-score", type=float, default=None,
                        help="0..1 (or 0..10 — auto-normalized)")
    parser.add_argument("--self-assess-concept", default=None)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true",
                        help="suppress non-error stdout")
    args = parser.parse_args(argv)

    learner_id = resolve_learner_login(args.state_root, explicit=args.learner_id)

    # Phase Y11 P1.4 — drill_answer + free-text --answer → 자동 채점.
    # core.drill.score_pending_answer는 pending offer를 직접 읽고 drill_answer
    # 이벤트를 자체 emit + record_turn + pending clear까지 수행하므로 일반
    # append 흐름과 중복 방지를 위해 *early branch + early return*.
    if (args.event_type == "drill_answer"
            and args.answer is not None
            and args.drill_concept is None
            and args.drill_score is None):
        from core.drill import score_pending_answer
        score = score_pending_answer(args.answer, state_root=args.state_root)
        if score is None:
            print("ERROR: no pending drill (run drill mode first)", file=sys.stderr)
            return 2
        if not args.silent:
            import json
            print(json.dumps({
                "drill_answer_scored": True,
                "dimensions": score.dimensions,
                "total": score.total,
            }, ensure_ascii=False))
        return 0

    event_id = f"{args.event_type}-{int(time.time() * 1000)}-{uuid.uuid4().hex[:6]}"
    payload = {
        "prompt": args.prompt,
        "answer": args.answer,
        "citations": args.citation or [],
        "quality_flags": args.quality_flag or [],
    }
    if args.drill_concept is not None:
        payload["concept_id"] = args.drill_concept
        if args.drill_score is not None:
            payload["score"] = args.drill_score
    if args.self_assess_concept is not None:
        payload["concept_id"] = args.self_assess_concept

    event = {
        "event_id": event_id,
        "event_type": args.event_type,
        "mode": args.mode,
        "learner_id": learner_id,
        "repo": args.repo,
        "payload": payload,
    }
    append_history_event(event, state_root=args.state_root)

    # Mastery autoloop (D-C): drill_score / self_assess / mission_use evidence
    if args.mode == "learning":
        promoted = record_turn(event, state_root=args.state_root)
        if promoted:
            for cid, level in promoted:
                print(f"  → {cid}: {level}", flush=True)

    if args.mode == "learning" and (args.add_mastered or args.add_uncertain):
        profile = load_profile(learner_id, state_root=args.state_root)
        if args.add_mastered:
            profile.mastered_concepts = sorted(set(profile.mastered_concepts) | set(args.add_mastered))
        if args.add_uncertain:
            profile.uncertain_concepts = sorted(set(profile.uncertain_concepts) | set(args.add_uncertain))
        profile.total_events += 1
        save_profile(profile, state_root=args.state_root)

    print(event_id)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
