#!/usr/bin/env python3
"""bin/learn-event — append a learner event to history.jsonl + optional profile signals.

The AI session calls this AFTER drafting the learner-facing answer:

  bin/learn-event \\
      --event-type rag_ask --mode learning --prompt "..." --answer "..." \\
      --citation spring/bean --citation spring/component

When --add-mastered / --add-uncertain are passed, profile.json is updated
(LearnerProfile recompute is the AI session's job, not this CLI).
"""
from __future__ import annotations

import argparse
import sys
import time
import uuid
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT, append_history_event, load_profile, save_profile  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--event-type", required=True,
                        choices=("rag_ask", "coach_run", "drill_answer", "self_assessment",
                                 "code_attempt", "test_result", "response_quality"))
    parser.add_argument("--mode", default="learning",
                        choices=("learning", "development", "test"))
    parser.add_argument("--learner-id", default="default")
    parser.add_argument("--repo", default=None)
    parser.add_argument("--prompt", default=None)
    parser.add_argument("--answer", default=None)
    parser.add_argument("--citation", action="append", default=None)
    parser.add_argument("--quality-flag", action="append", default=None)
    parser.add_argument("--add-mastered", action="append", default=None)
    parser.add_argument("--add-uncertain", action="append", default=None)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    args = parser.parse_args(argv)

    event_id = f"{args.event_type}-{int(time.time() * 1000)}-{uuid.uuid4().hex[:6]}"
    event = {
        "event_id": event_id,
        "event_type": args.event_type,
        "mode": args.mode,
        "learner_id": args.learner_id,
        "repo": args.repo,
        "payload": {
            "prompt": args.prompt,
            "answer": args.answer,
            "citations": args.citation or [],
            "quality_flags": args.quality_flag or [],
        },
    }
    append_history_event(event, state_root=args.state_root)

    if args.mode == "learning" and (args.add_mastered or args.add_uncertain):
        profile = load_profile(args.learner_id, state_root=args.state_root)
        if args.add_mastered:
            profile.mastered_concepts = sorted(set(profile.mastered_concepts) | set(args.add_mastered))
        if args.add_uncertain:
            profile.uncertain_concepts = sorted(set(profile.uncertain_concepts) | set(args.add_uncertain))
        profile.total_events += 1
        save_profile(profile, state_root=args.state_root)

    print(event_id)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
