#!/usr/bin/env python3
"""bin/cohort-compare — diff two cohort-eval reports (Phase W8/Y13-A).

CLI: bin/cohort-compare --control A.json --candidate B.json [--fail-on-drift]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--control", type=Path, required=True)
    parser.add_argument("--candidate", type=Path, required=True)
    parser.add_argument("--fail-on-drift", action="store_true",
                        help="exit 1 if accuracy regresses ≥1pp OR p95 ≥10% slower")
    args = parser.parse_args(argv)

    a_report = json.loads(args.control.read_text(encoding="utf-8"))
    b_report = json.loads(args.candidate.read_text(encoding="utf-8"))
    a = a_report.get("summary", {})
    b = b_report.get("summary", {})

    acc_drift = (b.get("mode_accuracy") or 0) - (a.get("mode_accuracy") or 0)
    top1_drift = (b.get("top1_match_rate") or 0) - (a.get("top1_match_rate") or 0)
    ndcg_drift = (b.get("ndcg_at_5") or 0) - (a.get("ndcg_at_5") or 0)
    mrr_drift = (b.get("mrr") or 0) - (a.get("mrr") or 0)
    p50_drift = ((b.get("latency_p50_ms") or 0) - (a.get("latency_p50_ms") or 0))
    p95_drift = ((b.get("latency_p95_ms") or 0) - (a.get("latency_p95_ms") or 0))
    p95_pct = (p95_drift / max(a.get("latency_p95_ms") or 1, 0.001)) * 100

    report = {
        "control": a, "candidate": b,
        "accuracy_drift_pp": round(acc_drift * 100, 2),
        "top1_drift_pp": round(top1_drift * 100, 2),
        "ndcg_at_5_drift_pp": round(ndcg_drift * 100, 2),
        "mrr_drift_pp": round(mrr_drift * 100, 2),
        "latency_p50_drift_ms": round(p50_drift, 1),
        "latency_p95_drift_ms": round(p95_drift, 1),
        "latency_p95_drift_pct": round(p95_pct, 1),
    }
    print(json.dumps(report, ensure_ascii=False, indent=2))
    if args.fail_on_drift and (
        acc_drift < -0.01
        or top1_drift < -0.01
        or ndcg_drift < -0.01
        or p95_pct > 10
    ):
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
