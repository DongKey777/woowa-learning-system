#!/usr/bin/env python3
"""bin/learn-record-code — record a learner code-attempt event (Phase T2).

AI session auto-calls this after Write/Edit on a learner mission file.
Concept_ids are auto-inferred from the file content via mission.extract;
override with --concept-id if explicit.

Usage:
  bin/learn-record-code --file-path missions/<r>/src/main/java/X.java \\
                        --summary "ReservationService refactor" \\
                        [--lines-added 23] [--lines-removed 5] \\
                        [--linked-test ReservationServiceTest.shouldFoo] \\
                        [--repo R] [--concept-id spring/transactional-basics] [--silent]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.code_event import record_code_attempt  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--file-path", required=True)
    parser.add_argument("--summary", required=True)
    parser.add_argument("--repo", default=None)
    parser.add_argument("--lines-added", type=int, default=None)
    parser.add_argument("--lines-removed", type=int, default=None)
    parser.add_argument("--linked-test", default=None)
    parser.add_argument("--concept-id", action="append", default=None,
                        help="explicit concept_id (skip auto-inference)")
    parser.add_argument("--learner-id", default="default")
    parser.add_argument("--mode", default="learning",
                        choices=("learning", "development", "test"))
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    event = record_code_attempt(
        file_path=args.file_path,
        summary=args.summary,
        repo=args.repo,
        lines_added=args.lines_added,
        lines_removed=args.lines_removed,
        linked_test=args.linked_test,
        explicit_concept_ids=args.concept_id,
        learner_id=args.learner_id,
        mode=args.mode,
        state_root=args.state_root,
    )
    if not args.silent:
        print(json.dumps({
            "event_id": event["event_id"],
            "file_path": event["payload"]["file_path"],
            "summary": event["payload"]["summary"],
            "concept_ids": event["payload"]["concept_ids"],
            "concept_source": event["payload"]["concept_source"],
        }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
