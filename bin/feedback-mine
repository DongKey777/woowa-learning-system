#!/usr/bin/env python3
"""bin/feedback-mine — mine learn-feedback signals (Phase W1).

Aggregates state/learner/feedback.jsonl (helpful/not_helpful/unclear).
Currently `bin/learn-feedback` (Phase X3) generates this file — empty
until learner provides explicit feedback. Mine wrapper works on empty too.
"""
from __future__ import annotations

import argparse
import json
import sys
from collections import Counter
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from scripts.mining.jsonl_iter import (  # noqa: E402
    is_backfilled,
    is_fixture_or_demo_row,
    iter_jsonl,
    parse_since_ts,
)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--top-n", type=int, default=10)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument(
        "--since",
        help="Only include rows since duration/epoch/ISO timestamp, e.g. 7d or 2026-05-27T00:00:00Z",
    )
    args = parser.parse_args(argv)

    path = args.state_root / "learner" / "feedback.jsonl"
    try:
        since_ts = parse_since_ts(args.since)
    except ValueError as exc:
        parser.error(str(exc))

    total = 0
    skipped_fixture_or_demo = 0
    backfilled_n = 0
    signal_counter: Counter = Counter()
    doc_counter_neg: Counter = Counter()
    doc_counter_pos: Counter = Counter()

    for r in iter_jsonl(
        path,
        since_ts=since_ts,
        exclude_modes=("development", "test"),
    ):
        if is_fixture_or_demo_row(r):
            skipped_fixture_or_demo += 1
            continue
        total += 1
        backfilled_n += int(is_backfilled(r))
        signal_counter[r.get("signal", "?")] += 1
        for d in r.get("doc_paths", []) or []:
            if r.get("signal") == "not_helpful":
                doc_counter_neg[d] += 1
            elif r.get("signal") == "helpful":
                doc_counter_pos[d] += 1

    print(json.dumps({
        "feedback_log_path": str(path),
        "since": args.since,
        "since_ts": since_ts,
        "total_signals": total,
        "rows_backfilled_n": backfilled_n,
        "rows_original_n": total - backfilled_n,
        "rows_skipped_fixture_or_demo_n": skipped_fixture_or_demo,
        "signals_by_type": dict(signal_counter),
        "top_not_helpful_docs": [{"doc": d, "n": n}
                                  for d, n in doc_counter_neg.most_common(args.top_n)],
        "top_helpful_docs": [{"doc": d, "n": n}
                              for d, n in doc_counter_pos.most_common(args.top_n)],
    }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
