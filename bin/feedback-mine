#!/usr/bin/env python3
"""bin/feedback-mine — mine learn-feedback signals (Phase W1).

Aggregates state/cs_rag/feedback.jsonl (helpful/not_helpful/unclear).
Currently `bin/learn-feedback` (Phase X3) generates this file — empty
until learner provides explicit feedback. Mine wrapper works on empty too.
"""
from __future__ import annotations

import argparse
import json
import sys
from collections import Counter
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from scripts.mining.jsonl_iter import iter_jsonl  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--top-n", type=int, default=10)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    args = parser.parse_args(argv)

    path = args.state_root / "cs_rag" / "feedback.jsonl"
    rows = list(iter_jsonl(path))

    signal_counter: Counter = Counter(r.get("signal", "?") for r in rows)
    doc_counter_neg: Counter = Counter()
    doc_counter_pos: Counter = Counter()
    for r in rows:
        for d in r.get("doc_paths", []) or []:
            if r.get("signal") == "not_helpful":
                doc_counter_neg[d] += 1
            elif r.get("signal") == "helpful":
                doc_counter_pos[d] += 1

    print(json.dumps({
        "feedback_log_path": str(path),
        "total_signals": len(rows),
        "signals_by_type": dict(signal_counter),
        "top_not_helpful_docs": [{"doc": d, "n": n}
                                  for d, n in doc_counter_neg.most_common(args.top_n)],
        "top_helpful_docs": [{"doc": d, "n": n}
                              for d, n in doc_counter_pos.most_common(args.top_n)],
    }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
