#!/usr/bin/env python3
"""bin/topic — cs_qa scoped to a concept family (Phase V5).

CLI: bin/topic --concept C [--query Q] [--repo R]
"""
from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--concept", required=True,
                        help="concept_id (e.g. spring/transactional-basics)")
    parser.add_argument("--query", default=None,
                        help="extra learner question (else: '<concept> 자세히 설명')")
    parser.add_argument("--repo", default=None)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    prompt = args.query or f"{args.concept} 자세히 설명해줘"
    cmd = [sys.executable, str(REPO_ROOT / "bin" / "ask"), prompt]
    if args.repo:
        cmd.extend(["--repo", args.repo])
    return subprocess.call(cmd)


if __name__ == "__main__":
    raise SystemExit(main())
