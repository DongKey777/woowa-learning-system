#!/usr/bin/env python3
"""bin/learn-predict-build — family K builder (repo-scoped).

Pre-push prediction synthesis: fuses three already-built per-repo artifacts —
reviewer_profile.json (C), cohort.json (F), pr_diff_evolution.json (H) — into a
forward-looking, advisory prediction (likely review topics, likely hotspot
files, smell warnings, and a review-load projection). Read-only synthesis: it
does NOT re-query SQLite or git. Writes state/repos/<repo>/predict.json (loaded
in mode predict). See mission/predict.py for the synthesis contract.

Usage:
  bin/learn-predict-build --repo spring-roomescape-member [--learner-login DongKey777]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.predict import analyze_repo, save_predict  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    report = analyze_repo(args.repo, learner, args.state_root)
    out = save_predict(report, args.state_root)
    if args.silent:
        return 0
    print(json.dumps({"repo": report["repo"], "status": report["status"],
                      "inputs": report["inputs"], "counts": report["counts"]},
                     ensure_ascii=False))
    print(f"  wrote: {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
