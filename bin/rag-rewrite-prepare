#!/usr/bin/env python3
"""bin/rag-rewrite-prepare — query rewrite prompt template (Phase V10).

Emits a markdown prompt for the AI session to perform query rewriting
in one of 3 modes:
  hyde      — write a 1-paragraph hypothetical answer (good for vague queries)
  decompose — split into 2-3 sub-questions (good for compound queries)
  normalize — rewrite to canonical Korean concept terms (corpus-friendly)

CLI: bin/rag-rewrite-prepare --mode hyde|decompose|normalize --query Q
"""
from __future__ import annotations

import argparse
import json
import sys

TEMPLATES = {
    "hyde": (
        "다음 학습자 질문에 대한 1단락 가상 답변을 작성해 (실제 사실 검증 X, "
        "코퍼스 친화적 어휘 사용). 이 답변은 dense embedding 매칭용 query 보강이야.\n\n"
        "Query: {query}\n\nHyDE answer (1단락, 200자 이내):"
    ),
    "decompose": (
        "다음 복합 질문을 2-3개 sub-question으로 분해해. 각 sub-question은 "
        "독립적으로 검색 가능해야 해.\n\n"
        "Query: {query}\n\n"
        "Output:\n- sub_q_1: ...\n- sub_q_2: ...\n- sub_q_3: ... (optional)"
    ),
    "normalize": (
        "다음 학습자 자연어 질문을 corpus 친화적인 표준 용어로 rewrite해. "
        "한국어 + Spring/Java 정식 용어 사용. 의도는 유지하되 corpus 어휘 매칭 향상.\n\n"
        "Query: {query}\n\nNormalized: <rewritten query 1줄>"
    ),
}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mode", required=True,
                        choices=("hyde", "decompose", "normalize"))
    parser.add_argument("--query", required=True)
    parser.add_argument("--out", default=None,
                        help="write to file (default: stdout)")
    args = parser.parse_args(argv)

    prompt = TEMPLATES[args.mode].format(query=args.query)
    payload = {"mode": args.mode, "query": args.query, "prompt": prompt}
    out = json.dumps(payload, ensure_ascii=False, indent=2)
    if args.out:
        from pathlib import Path
        Path(args.out).write_text(out, encoding="utf-8")
    else:
        print(out)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
