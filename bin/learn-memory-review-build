#!/usr/bin/env python3
"""bin/learn-memory-review-build — F2 / family M builder (cross-repo).

Memory / spaced-review analytics: blind spots (concepts I use in code but never
studied), forgetting reminders (familiar+ concepts past the retention window),
and review cards (real mentor feedback on my own code). Reads all of the
learner's state at once (state/learner/{mastery_graph.sqlite,history.jsonl,
review_anchors.json} + state/repos/*/mission_patterns.json) and writes
state/learner/memory_review.json (loaded in mode memory_review).

Cross-repo builder: run once after per-repo syncs, NOT inside the per-repo
sync-prs refresh loop. See mission/memory_review.py for the analysis contract.

Usage:
  bin/learn-memory-review-build [--learner-login DongKey777]
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.memory_review import analyze, save_memory_review  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    report = analyze(learner, args.state_root)
    out = save_memory_review(report, args.state_root)
    if args.silent:
        return 0
    print(f"learner={learner} status={report['status']}")
    print(f"  blind_spots={len(report['blind_spots'])} "
          f"forgetting={len(report['forgetting'])} "
          f"review_cards={len(report['review_cards'])}")
    for b in report["blind_spots"][:8]:
        print(f"    · blind: {b['concept_id']} "
              f"(level={b['bloom_level'] or 'none'}, repos={b['repos']})")
    print(f"  wrote: {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
