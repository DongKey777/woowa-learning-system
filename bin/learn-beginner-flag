#!/usr/bin/env python3
"""bin/learn-beginner-flag — learner self-declared 'beginner' concepts (W7).

The AI session, on JUDGING (semantically, not by keyword) that the learner is
new to a concept / wants the basics re-explained, flags it here. Flagged
concepts are subtracted from must_skip_explanations_of so they are always
re-explained even if mastery over-promoted them. Learner-wide (single learner).

CLI: bin/learn-beginner-flag --concept <id> [--clear] [--list] [--silent]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import (  # noqa: E402
    DEFAULT_STATE_ROOT, load_beginner_flags, save_beginner_flags,
)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--concept", default=None, help="concept_id to flag/clear")
    parser.add_argument("--clear", action="store_true", help="remove --concept from the list")
    parser.add_argument("--list", action="store_true", help="print current flags and exit")
    parser.add_argument("--learner-id", default=None)  # accepted for convention
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    current = load_beginner_flags(args.state_root)

    if args.list:
        print(json.dumps({"concepts": current}, ensure_ascii=False, indent=2))
        return 0
    if not args.concept:
        print("ERROR: --concept required (or use --list)", file=sys.stderr)
        return 2

    if args.clear:
        updated = [c for c in current if c != args.concept]
    else:
        updated = list(current)
        if args.concept not in updated:
            updated.append(args.concept)
    save_beginner_flags(updated, args.state_root)

    if not args.silent:
        print(json.dumps({
            "concept": args.concept,
            "action": "cleared" if args.clear else "flagged",
            "concepts": updated,
        }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
