#!/usr/bin/env python3
"""bin/learn-pr-review-build — F2 / family A+N builder (repo-scoped).

Received-review surface: concept-linked review anchors on the learner's own
code, unresolved mentor threads (no learner reply), and a PR-level issue-comment
overview. Reads state/repos/<repo>/archive/prs.sqlite3 +
state/learner/review_anchors.json and writes state/repos/<repo>/pr_review.json
(loaded in mode pr_review). See mission/pr_review.py for the analysis contract.

Usage:
  bin/learn-pr-review-build --repo spring-roomescape-waiting [--learner-login DongKey777]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.pr_review import analyze, save_pr_review  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    report = analyze(args.repo, learner, args.state_root)
    out = save_pr_review(report, args.state_root)
    if args.silent:
        return 0
    print(json.dumps({"repo": report["repo"], "status": report["status"],
                      "counts": report["counts"]}, ensure_ascii=False))
    print(f"  wrote: {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
