#!/bin/sh
''':'
# Fast executable path: avoid Python startup when the daemon is already warm.
# Direct `python3 bin/ask ...` still runs the Python implementation below.
_ask_json_safe() {
  case "$1" in
    *\"*|*\\*|*$'\n'*|*$'\r'*|*$'\t'*) return 1 ;;
    *) return 0 ;;
  esac
}

_ask_json_value() {
  if [ -z "$1" ]; then
    printf 'null'
  else
    printf '"%s"' "$1"
  fi
}

_ask_identity_from_state_root() {
  identity_file="$1/learner/identity.json"
  [ -r "$identity_file" ] || return 1
  learner_id="$(sed -nE 's/.*"learner_id"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' "$identity_file" | head -n 1)"
  if [ -z "$learner_id" ]; then
    learner_id="$(sed -nE 's/.*"github_login"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' "$identity_file" | head -n 1)"
  fi
  [ -n "$learner_id" ] || return 1
  printf '%s' "$learner_id"
}

_ask_fast() {
  [ "$#" -gt 0 ] || return 1
  case "$1" in -h|--help|-*) return 1 ;; esac
  command -v nc >/dev/null 2>&1 || return 1

  prompt="$1"
  repo=""
  learner_id=""
  state_root=""
  reformulated_query=""
  route_mode=""
  raw_utterance=""
  session_mode_explicit=""
  json_mode=0
  json_route=0
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --repo) [ "$#" -ge 2 ] || return 1; repo="$2"; shift 2 ;;
      --learner-id) [ "$#" -ge 2 ] || return 1; learner_id="$2"; shift 2 ;;
      --state-root) [ "$#" -ge 2 ] || return 1; state_root="$2"; shift 2 ;;
      --reformulated-query) [ "$#" -ge 2 ] || return 1; reformulated_query="$2"; shift 2 ;;
      --mode) [ "$#" -ge 2 ] || return 1; route_mode="$2"; shift 2 ;;
      --raw-utterance) [ "$#" -ge 2 ] || return 1; raw_utterance="$2"; shift 2 ;;
      --session-mode) [ "$#" -ge 2 ] || return 1; session_mode_explicit="$2"; shift 2 ;;
      --json) json_mode=1; shift ;;
      --json-route) json_route=1; shift ;;
      --no-daemon) return 1 ;;
      *) return 1 ;;
    esac
  done

  if [ -n "$state_root" ]; then
    sock_path="$state_root/rag-daemon.sock"
    identity_root="$state_root"
  else
    script_dir="${0%/*}"
    [ "$script_dir" = "$0" ] && script_dir="."
    repo_root="$(cd "$script_dir/.." 2>/dev/null && pwd)" || return 1
    identity_root="$repo_root/state"
    sock_path="$identity_root/rag-daemon.sock"
  fi
  if [ -z "$learner_id" ]; then
    learner_id="$(_ask_identity_from_state_root "$identity_root" 2>/dev/null || printf default)"
  fi

  for value in "$prompt" "$repo" "$learner_id" "$state_root" "$reformulated_query" "$route_mode" "$raw_utterance" "$session_mode_explicit" "${WOOWA_SESSION_MODE:-learning}" "${WOOWA_REFORMULATE:-}"; do
    _ask_json_safe "$value" || return 1
  done
  [ -S "$sock_path" ] || return 1

  if [ "$json_mode" -eq 1 ]; then
    action="ask"
  else
    action="ask_text"
  fi
  # Session mode + provenance resolved here so the daemon never re-guesses from
  # env: explicit --session-mode wins, else env, else conservative learning.
  if [ -n "$session_mode_explicit" ]; then
    mode="$session_mode_explicit"
    mode_source="explicit"
  elif [ -n "${WOOWA_SESSION_MODE:-}" ]; then
    mode="$WOOWA_SESSION_MODE"
    mode_source="env"
  else
    mode="learning"
    mode_source="default"
  fi
  reformulation="${WOOWA_REFORMULATE:-}"
  payload=$(printf '{"action":"%s","query":"%s","repo":%s,"learner_id":"%s","mode":"%s","mode_source":"%s","reformulation":%s,"json_route":%s,"reformulated_query":%s,"route_mode":%s,"raw_utterance":%s}\n' \
    "$action" "$prompt" "$(_ask_json_value "$repo")" "$learner_id" "$mode" "$mode_source" \
    "$(_ask_json_value "$reformulation")" "$json_route" "$(_ask_json_value "$reformulated_query")" \
    "$(_ask_json_value "$route_mode")" "$(_ask_json_value "$raw_utterance")")
  response=$(printf '%s' "$payload" | nc -U -w 30 "$sock_path" 2>/dev/null) || return 1
  [ -n "$response" ] || return 1
  printf '%s\n' "$response"
}

if _ask_fast "$@"; then
  exit 0
fi

exec python3 -S "$0" "$@"
':'''
"""bin/ask — thin socket client for daemon ask. Inline argv parse (no argparse)
for sub-25ms cold-start. Falls back to in-process pipeline when daemon down.
"""
import json
import os
import socket
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO_ROOT)
DEFAULT_SOCK = os.path.join(REPO_ROOT, "state", "rag-daemon.sock")
TIMEOUT_S = 30


def parse_argv(argv):
    """Minimal argv parser — faster than argparse for hot path."""
    if not argv or argv[0] in ("-h", "--help"):
        print("Usage: bin/ask <prompt> [--repo R] [--learner-id L] [--mode M] "
              "[--raw-utterance U] [--session-mode S] [--json-route] [--no-daemon]",
              file=sys.stderr)
        return None
    out = {"prompt": argv[0], "repo": None, "learner_id": None,
           "json_route": False, "no_daemon": False, "state_root": None,
           "json_mode": False, "reformulated_query": None, "route_mode": None,
           "raw_utterance": None, "session_mode": None}
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--repo" and i + 1 < len(argv):
            out["repo"] = argv[i + 1]; i += 2
        elif a == "--learner-id" and i + 1 < len(argv):
            out["learner_id"] = argv[i + 1]; i += 2
        elif a == "--state-root" and i + 1 < len(argv):
            out["state_root"] = argv[i + 1]; i += 2
        elif a == "--reformulated-query" and i + 1 < len(argv):
            out["reformulated_query"] = argv[i + 1]; i += 2
        elif a == "--mode" and i + 1 < len(argv):
            out["route_mode"] = argv[i + 1]; i += 2
        elif a == "--raw-utterance" and i + 1 < len(argv):
            out["raw_utterance"] = argv[i + 1]; i += 2
        elif a == "--session-mode" and i + 1 < len(argv):
            out["session_mode"] = argv[i + 1]; i += 2
        elif a == "--json":
            out["json_mode"] = True; i += 1
        elif a == "--json-route":
            out["json_route"] = True; i += 1
        elif a == "--no-daemon":
            out["no_daemon"] = True; i += 1
        else:
            i += 1
    return out


def daemon_ask(args):
    sock_path = (os.path.join(args["state_root"], "rag-daemon.sock")
                 if args["state_root"] else DEFAULT_SOCK)
    if not os.path.exists(sock_path):
        return None
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(TIMEOUT_S)
        sock.connect(sock_path)
        if args.get("session_mode"):
            mode, mode_source = args["session_mode"], "explicit"
        elif os.environ.get("WOOWA_SESSION_MODE"):
            mode, mode_source = os.environ["WOOWA_SESSION_MODE"], "env"
        else:
            mode, mode_source = "learning", "default"
        req_payload = {"action": "ask", "query": args["prompt"],
                       "repo": args["repo"], "learner_id": args["learner_id"],
                       "mode": mode, "mode_source": mode_source,
                       "reformulation": os.environ.get("WOOWA_REFORMULATE")}
        if args.get("reformulated_query"):
            req_payload["reformulated_query"] = args["reformulated_query"]
        if args.get("route_mode"):
            req_payload["route_mode"] = args["route_mode"]
        if args.get("raw_utterance"):
            req_payload["raw_utterance"] = args["raw_utterance"]
        req = json.dumps(req_payload) + "\n"
        sock.sendall(req.encode("utf-8"))
        data = b""
        while True:
            chunk = sock.recv(65536)
            if not chunk:
                break
            data += chunk
        sock.close()
        return json.loads(data.decode("utf-8").strip())
    except (OSError, json.JSONDecodeError):
        return None


def render(resp, json_route, json_mode=False):
    if json_mode:
        # v2-native machine-readable mode — single JSON object on stdout,
        # no markdown/hint comment lines mixed in.
        print(json.dumps(resp, ensure_ascii=False))
        return
    if json_route:
        print("# RouteDecision: " + json.dumps({
            "mode": resp.get("mode"),
            "personas": resp.get("personas", []),
            "budget_tokens": resp.get("budget"),
            "reason": resp.get("reason"),
        }, ensure_ascii=False))
    hints = resp.get("response_hints")
    if hints:
        print("# response_hints: " + json.dumps(hints, ensure_ascii=False))
    rq_hint = resp.get("response_quality_hint")
    if rq_hint:
        print("# response_quality_hint: " + json.dumps(rq_hint, ensure_ascii=False))
    print(resp["markdown"])


def main(argv=None):
    args = parse_argv(argv if argv is not None else sys.argv[1:])
    if args is None:
        return 2
    if args["learner_id"] is None:
        from pathlib import Path
        from core.identity import resolve_learner_login

        state_root = Path(args["state_root"]) if args["state_root"] else Path(REPO_ROOT) / "state"
        args["learner_id"] = resolve_learner_login(state_root)

    # Daemon fast-path
    if not args["no_daemon"]:
        resp = daemon_ask(args)
        if resp is not None and "markdown" in resp:
            render(resp, args["json_route"], args["json_mode"])
            return 0

    # Fallback: in-process (cold path, heavy imports)
    import site  # noqa: E402  # enable installed deps only off the daemon fast path
    if hasattr(site, "main"):
        site.main()
    sys.path.insert(0, REPO_ROOT)
    from pathlib import Path  # noqa: E402
    from core.coach import compose  # noqa: E402
    from core.lazy_loader import load  # noqa: E402
    from core.reformulate import reformulation_enabled, select_reformulation  # noqa: E402
    from core.router import route, strip_override_tokens  # noqa: E402
    from core.state import DEFAULT_STATE_ROOT, load_profile, read_history  # noqa: E402
    from core.trigger import (  # noqa: E402
        load_drill_history,
        load_pending_triggers,
        load_profile_payload,
        select_cognitive_trigger,
        write_pending_triggers_atomic,
    )
    sr = Path(args["state_root"]) if args["state_root"] else DEFAULT_STATE_ROOT
    session_mode = os.environ.get("WOOWA_SESSION_MODE", "learning")

    profile = load_profile(args["learner_id"], state_root=sr)
    recent = read_history(sr, tail=20)
    reformulation = select_reformulation(
        prompt=args["prompt"],
        explicit_reformulated_query=args.get("reformulated_query"),
        history=recent,
        repo=args["repo"],
        enabled=reformulation_enabled(),
    )
    reformulated_query = (
        reformulation.reformulated_query if reformulation else ""
    )
    decision = route(
        args["prompt"], repo=args["repo"],
        pending_self_assessment=profile.pending_triggers.get("self_assessment"),
        pending_drill=profile.pending_triggers.get("review_drill"),
        mode_override=args.get("route_mode"),
    )
    if decision.mode == "tier_0_fallback" and reformulated_query:
        decision = route(
            reformulated_query, repo=args["repo"],
            pending_self_assessment=profile.pending_triggers.get("self_assessment"),
            pending_drill=profile.pending_triggers.get("review_drill"),
            mode_override=args.get("route_mode"),
        )

    if decision.mode == "retro" and not args["repo"]:
        print("ERROR: --repo required for retro mode", file=sys.stderr)
        return 2

    retrieval_query = reformulated_query or strip_override_tokens(args["prompt"])
    artifacts = load(
        decision,
        repo=args["repo"],
        state_root=sr,
        query=retrieval_query,
        learner_profile=profile,
    )
    if decision.mode == "drill":
        from core.drill import build_offer_if_due  # noqa: E402

        offer = build_offer_if_due(
            learner_id=args["learner_id"],
            state_root=sr,
            uncertain_concept_ids=profile.uncertain_concepts or [],
        )
        if offer:
            artifacts["drill_offer"] = {
                "concept_id": offer.concept_id,
                "question": offer.question,
                "expected_terms": offer.expected_terms,
                "source": offer.source,
            }
    if reformulated_query:
        artifacts["reformulated_query"] = reformulated_query
    if reformulation:
        artifacts["reformulation_trace"] = reformulation.to_dict()
    from core.drill import read_last_proactive_offer_at  # noqa: E402
    cognitive_trigger = (
        select_cognitive_trigger(
            history=recent,
            profile=load_profile_payload(sr, repo=args["repo"]),
            drill_pending=profile.pending_triggers.get("review_drill"),
            drill_history=load_drill_history(sr) or profile.drill_due,
            intent={"detected_intent": decision.mode},
            pending_triggers=profile.pending_triggers,
            uncertain_concepts=profile.uncertain_concepts,
            last_drill_offer_at=read_last_proactive_offer_at(sr),
        )
        if session_mode not in ("development", "test")
        else {"trigger_type": "none"}
    )
    if cognitive_trigger.get("trigger_type") == "self_assessment":
        from datetime import datetime, timedelta, timezone  # noqa: E402

        pending = load_pending_triggers(sr)
        trigger_to_store = dict(cognitive_trigger)
        issued_at = datetime.now(timezone.utc)
        trigger_to_store.setdefault("issued_at", issued_at.isoformat())
        trigger_to_store.setdefault(
            "expires_at", (issued_at + timedelta(hours=24)).isoformat()
        )
        pending["self_assessment"] = trigger_to_store
        write_pending_triggers_atomic(pending, sr)
        artifacts["cognitive_trigger"] = trigger_to_store
    elif cognitive_trigger.get("trigger_type") == "review_drill":
        from core.drill import build_review_offer_if_due  # noqa: E402

        offer = build_review_offer_if_due(
            learner_id=args["learner_id"],
            state_root=sr,
        )
        if offer:
            cognitive_trigger = {
                **cognitive_trigger,
                "payload": {
                    **(cognitive_trigger.get("payload") or {}),
                    "concept_id": offer.concept_id,
                    "drill_session_id": offer.drill_session_id,
                },
                "markdown": (
                    "## 복습 드릴\n"
                    f"- 이전 드릴을 다시 풀어볼 차례야: {offer.question}"
                ),
            }
            artifacts["drill_offer"] = {
                "concept_id": offer.concept_id,
                "question": offer.question,
                "expected_terms": offer.expected_terms,
                "source": offer.source,
            }
        artifacts["cognitive_trigger"] = cognitive_trigger
    elif cognitive_trigger.get("trigger_type") == "follow_up":
        artifacts["cognitive_trigger"] = cognitive_trigger
    elif cognitive_trigger.get("trigger_type") == "proactive_drill":
        from core.drill import build_offer_if_due, write_last_proactive_offer_at  # noqa: E402

        offer = build_offer_if_due(
            learner_id=args["learner_id"], state_root=sr,
            uncertain_concept_ids=profile.uncertain_concepts or [],
        )
        if offer:
            artifacts["drill_offer"] = {
                "concept_id": offer.concept_id,
                "question": offer.question,
                "expected_terms": offer.expected_terms,
                "source": offer.source,
            }
            artifacts["cognitive_trigger"] = cognitive_trigger
            write_last_proactive_offer_at(offer.created_at, sr)
        # else: no resolvable question -> drop the trigger silently.

    # Phase Y11 cold path: no event_id / no history append, so
    # response_quality_hint is None. The AI session can still read
    # response_hints.citation_markdown for paste-ready citations.
    # W7: subtract self-declared-beginner concepts (always re-explain those).
    _beginner = set(getattr(profile, "self_declared_beginner_concepts", []) or [])
    skip_targets = sorted(
        (set(profile.mastered_concepts)
         | set(getattr(profile, "proficient_concepts", [])))
        - _beginner
    )
    learner_context = (
        {"must_skip_explanations_of": skip_targets}
        if skip_targets else None
    )
    markdown, response_hints, _rq_hint, effective_route = compose(
        decision, artifacts, args["prompt"],
        repo=args["repo"], learner_id=args["learner_id"], recent_history=recent,
        source_event_id=None, state_root=sr,
        learner_context=learner_context,
    )
    if args["json_mode"]:
        print(json.dumps({
            "markdown": markdown,
            "mode": effective_route.mode,
            "personas": effective_route.personas,
            "budget": effective_route.budget_tokens,
            "reason": effective_route.reason,
            "response_hints": response_hints,
            "response_quality_hint": None,
        }, ensure_ascii=False))
        return 0
    if args["json_route"]:
        print("# RouteDecision: " + json.dumps({
            "mode": effective_route.mode, "personas": effective_route.personas,
            "budget_tokens": effective_route.budget_tokens, "reason": effective_route.reason,
        }, ensure_ascii=False))
    if response_hints:
        print("# response_hints: " + json.dumps(response_hints, ensure_ascii=False))
    print(markdown)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
