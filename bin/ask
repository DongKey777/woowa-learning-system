#!/usr/bin/env python3
"""bin/ask — single learner entry point (paradigm-v2).

Pipeline (D-A hybrid paradigm):
  args → router.route → lazy_loader.load → coach.compose → stdout

The AI session reads the printed multi-agent prompt and writes the
learner-facing answer in the same turn, then optionally records via
`bin/learn-event` for the Bloom mastery autoloop.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.coach import compose  # noqa: E402
from core.lazy_loader import load  # noqa: E402
from core.router import route  # noqa: E402
from core.state import DEFAULT_STATE_ROOT, load_profile, read_history  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("prompt", type=str)
    parser.add_argument("--repo", type=str, default=None)
    parser.add_argument("--learner-id", type=str, default="default")
    parser.add_argument("--json-route", action="store_true",
                        help="emit RouteDecision JSON as first line")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    args = parser.parse_args(argv)

    profile = load_profile(args.learner_id, state_root=args.state_root)
    decision = route(
        args.prompt,
        repo=args.repo,
        pending_self_assessment=profile.pending_triggers.get("self_assessment"),
        pending_drill=profile.pending_triggers.get("review_drill"),
    )

    if decision.mode == "retro" and not args.repo:
        print("ERROR: --repo required for retro mode", file=sys.stderr)
        return 2

    artifacts = load(decision, repo=args.repo, state_root=args.state_root)
    recent = read_history(args.state_root)[-20:]

    if args.json_route:
        print("# RouteDecision: " + json.dumps({
            "mode": decision.mode,
            "personas": decision.personas,
            "budget_tokens": decision.budget_tokens,
            "lazy_artifacts": decision.lazy_artifacts,
            "reason": decision.reason,
        }, ensure_ascii=False))
    print(compose(decision, artifacts, args.prompt, repo=args.repo,
                  learner_id=args.learner_id, recent_history=recent))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
