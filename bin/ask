#!/usr/bin/env python3
"""bin/ask — single learner/AI entry point (D13 unified).

Pipeline:
  args → intent.detect_mode → context.collect_*() → prompt.build() → stdout

The AI session reads the printed markdown prompt, writes the learner-facing
answer, then optionally calls `bin/learn-event` to record the turn.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core import context as ctx_mod  # noqa: E402
from core.intent import detect_mode  # noqa: E402
from core.prompt import build  # noqa: E402
from core.state import DEFAULT_STATE_ROOT, load_profile, load_repo_state  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("prompt", type=str, help="learner natural-language prompt")
    parser.add_argument("--repo", type=str, default=None)
    parser.add_argument("--learner-id", type=str, default="default")
    parser.add_argument("--peer-pr", action="append", type=int, default=None)
    parser.add_argument("--json-decision", action="store_true",
                        help="emit IntentDecision as first line for AI session inspection")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    args = parser.parse_args(argv)

    profile = load_profile(args.learner_id, state_root=args.state_root)
    repo_state = load_repo_state(args.repo, state_root=args.state_root) if args.repo else None

    decision = detect_mode(
        args.prompt,
        repo=args.repo,
        pending_self_assessment=profile.pending_triggers.get("self_assessment"),
        pending_drill=(repo_state.threads if repo_state else None) and profile.pending_triggers.get("review_drill"),
    )

    if decision.mode == "cs_qa":
        context = ctx_mod.collect_cs_qa_context(args.prompt, learner_id=args.learner_id, state_root=args.state_root)
    elif decision.mode == "coaching":
        context = ctx_mod.collect_coaching_context(
            args.prompt, repo=args.repo, learner_id=args.learner_id,
            peer_pr_numbers=args.peer_pr, state_root=args.state_root,
        )
    elif decision.mode == "drill":
        context = ctx_mod.collect_drill_context(args.learner_id, state_root=args.state_root)
    elif decision.mode == "retro":
        if not args.repo:
            print("ERROR: --repo required for retro mode", file=sys.stderr)
            return 2
        context = ctx_mod.collect_retro_context(args.repo, args.learner_id, state_root=args.state_root)
    elif decision.mode == "self_assess":
        context = ctx_mod.collect_self_assess_context(args.learner_id, state_root=args.state_root)
    elif decision.mode == "tool_only":
        context = {"prompt": args.prompt}
    else:
        print(f"ERROR: unhandled mode {decision.mode}", file=sys.stderr)
        return 2

    if args.json_decision:
        print("# IntentDecision: " + json.dumps({
            "mode": decision.mode, "reason": decision.reason, "confidence": decision.confidence,
        }, ensure_ascii=False))
    print(build(decision.mode, context))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
