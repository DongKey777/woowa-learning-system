#!/usr/bin/env python3
"""bin/ask — single learner entry point (paradigm-v2 with daemon fast-path).

Pipeline:
  args → daemon.ask() (full pipeline in-daemon) → stdout
  fallback: in-process router → lazy_loader → coach.compose

Daemon path: ~25-35ms (socket-only). Fallback: ~65ms (full Python startup).
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("prompt", type=str)
    parser.add_argument("--repo", type=str, default=None)
    parser.add_argument("--learner-id", type=str, default="default")
    parser.add_argument("--json-route", action="store_true",
                        help="emit RouteDecision JSON as first line")
    parser.add_argument("--no-daemon", action="store_true",
                        help="skip daemon, force in-process")
    parser.add_argument("--state-root", type=Path, default=None)
    args = parser.parse_args(argv)

    # Try daemon first
    if not args.no_daemon:
        from core.daemon import ask as daemon_ask, DEFAULT_STATE_ROOT
        sr = args.state_root or DEFAULT_STATE_ROOT
        resp = daemon_ask(args.prompt, repo=args.repo, learner_id=args.learner_id, state_root=sr)
        if resp is not None and "markdown" in resp:
            if args.json_route:
                print("# RouteDecision: " + json.dumps({
                    "mode": resp.get("mode"), "personas": resp.get("personas", []),
                    "budget_tokens": resp.get("budget"), "reason": resp.get("reason"),
                }, ensure_ascii=False))
            print(resp["markdown"])
            return 0

    # Fallback: in-process (cold path)
    from core.coach import compose
    from core.lazy_loader import load
    from core.router import route
    from core.state import DEFAULT_STATE_ROOT, load_profile, read_history
    sr = args.state_root or DEFAULT_STATE_ROOT

    profile = load_profile(args.learner_id, state_root=sr)
    decision = route(
        args.prompt, repo=args.repo,
        pending_self_assessment=profile.pending_triggers.get("self_assessment"),
        pending_drill=profile.pending_triggers.get("review_drill"),
    )

    if decision.mode == "retro" and not args.repo:
        print("ERROR: --repo required for retro mode", file=sys.stderr)
        return 2

    artifacts = load(decision, repo=args.repo, state_root=sr, query=args.prompt)
    recent = read_history(sr, tail=20)

    if args.json_route:
        print("# RouteDecision: " + json.dumps({
            "mode": decision.mode, "personas": decision.personas,
            "budget_tokens": decision.budget_tokens, "reason": decision.reason,
        }, ensure_ascii=False))
    print(compose(decision, artifacts, args.prompt, repo=args.repo,
                  learner_id=args.learner_id, recent_history=recent))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
