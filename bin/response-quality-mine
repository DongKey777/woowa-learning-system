#!/usr/bin/env python3
"""bin/response-quality-mine — mine response-quality.jsonl (Phase W2)."""
from __future__ import annotations

import argparse
import json
import sys
from collections import Counter
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from scripts.mining.jsonl_iter import (  # noqa: E402
    is_backfilled,
    is_fixture_or_demo_row,
    iter_jsonl,
    parse_since_ts,
)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--top-n", type=int, default=10)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument(
        "--since",
        help="Only include rows since duration/epoch/ISO timestamp, e.g. 7d or 2026-05-27T00:00:00Z",
    )
    args = parser.parse_args(argv)

    path = args.state_root / "learner" / "response-quality.jsonl"
    try:
        since_ts = parse_since_ts(args.since)
    except ValueError as exc:
        parser.error(str(exc))

    total = 0
    skipped_fixture_or_demo = 0
    backfilled_n = 0
    flag_counter: Counter = Counter()
    contract_counter: Counter = Counter()
    capture_counter: Counter = Counter()
    expected_paths: Counter = Counter()
    declared_paths: Counter = Counter()
    full_body_paths_n = 0
    truncated_excerpt_n = 0
    body_deduped_n = 0
    capture_input_chars_total = 0
    response_chars_total = 0
    response_body_stored_bytes_total = 0
    for r in iter_jsonl(
        path,
        since_ts=since_ts,
        exclude_modes=("development", "test"),
    ):
        if is_fixture_or_demo_row(r):
            skipped_fixture_or_demo += 1
            continue
        total += 1
        backfilled_n += int(is_backfilled(r))
        for f in r.get("quality_flags", []) or []:
            flag_counter[f] += 1
        for f in r.get("contract_flags", []) or []:
            contract_counter[f] += 1
        capture_counter[r.get("capture_method") or "unknown"] += 1
        if r.get("response_body_path"):
            full_body_paths_n += 1
        if r.get("response_excerpt_truncated"):
            truncated_excerpt_n += 1
        if r.get("response_body_deduped"):
            body_deduped_n += 1
        capture_input_chars_total += int(r.get("capture_input_chars") or 0)
        response_chars_total += int(r.get("response_length_chars") or 0)
        response_body_stored_bytes_total += int(r.get("response_body_stored_bytes") or 0)
        for p in r.get("citation_paths_expected", []) or []:
            expected_paths[p] += 1
        for p in r.get("citation_paths_declared", []) or []:
            declared_paths[p] += 1

    missing_body = flag_counter.get("missing_response_body", 0)
    drift = (flag_counter.get("citation_mismatch", 0)
             + flag_counter.get("missing_citation", 0)
             + flag_counter.get("extra_citation", 0))
    repair_path = args.state_root / "learner" / "capture-repair-queue.jsonl"
    repair_counter: Counter = Counter()
    if repair_path.exists():
        for line in repair_path.read_text(encoding="utf-8").splitlines():
            if not line.strip():
                continue
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            ts = row.get("queued_at")
            if since_ts is not None and isinstance(ts, (int, float)) and ts < since_ts:
                continue
            repair_counter[row.get("status") or "unknown"] += 1
            if row.get("reason"):
                repair_counter[f"reason:{row['reason']}"] += 1

    print(json.dumps({
        "quality_log_path": str(path),
        "since": args.since,
        "since_ts": since_ts,
        "rows_total": total,
        "rows_backfilled_n": backfilled_n,
        "rows_original_n": total - backfilled_n,
        "rows_skipped_fixture_or_demo_n": skipped_fixture_or_demo,
        "missing_body_n": missing_body,
        "possible_summary_body_n": contract_counter.get("possible_summary_body", 0),
        "full_body_paths_n": full_body_paths_n,
        "truncated_excerpt_n": truncated_excerpt_n,
        "body_deduped_n": body_deduped_n,
        "capture_input_chars_total": capture_input_chars_total,
        "response_chars_total": response_chars_total,
        "response_body_stored_bytes_total": response_body_stored_bytes_total,
        "capture_input_to_response_ratio": (
            round(capture_input_chars_total / response_chars_total, 4)
            if response_chars_total else None
        ),
        "citation_drift_n": drift,
        "flag_counts": dict(flag_counter),
        "contract_flag_counts": dict(contract_counter),
        "capture_method_counts": dict(capture_counter),
        "capture_repair_counts": dict(repair_counter),
        "top_expected_citations": [{"path": p, "n": n}
                                     for p, n in expected_paths.most_common(args.top_n)],
        "top_declared_citations": [{"path": p, "n": n}
                                     for p, n in declared_paths.most_common(args.top_n)],
    }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
