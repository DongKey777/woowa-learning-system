#!/usr/bin/env python3
"""bin/response-quality-mine — mine response-quality.jsonl (Phase W2)."""
from __future__ import annotations

import argparse
import json
import sys
from collections import Counter
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from scripts.mining.jsonl_iter import (  # noqa: E402
    is_backfilled,
    is_fixture_or_demo_row,
    iter_jsonl,
    parse_since_ts,
)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--top-n", type=int, default=10)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument(
        "--since",
        help="Only include rows since duration/epoch/ISO timestamp, e.g. 7d or 2026-05-27T00:00:00Z",
    )
    args = parser.parse_args(argv)

    path = args.state_root / "learner" / "response-quality.jsonl"
    try:
        since_ts = parse_since_ts(args.since)
    except ValueError as exc:
        parser.error(str(exc))

    total = 0
    skipped_fixture_or_demo = 0
    backfilled_n = 0
    flag_counter: Counter = Counter()
    expected_paths: Counter = Counter()
    declared_paths: Counter = Counter()
    for r in iter_jsonl(
        path,
        since_ts=since_ts,
        exclude_modes=("development", "test"),
    ):
        if is_fixture_or_demo_row(r):
            skipped_fixture_or_demo += 1
            continue
        total += 1
        backfilled_n += int(is_backfilled(r))
        for f in r.get("quality_flags", []) or []:
            flag_counter[f] += 1
        for p in r.get("citation_paths_expected", []) or []:
            expected_paths[p] += 1
        for p in r.get("citation_paths_declared", []) or []:
            declared_paths[p] += 1

    missing_body = flag_counter.get("missing_response_body", 0)
    drift = (flag_counter.get("citation_mismatch", 0)
             + flag_counter.get("missing_citation", 0)
             + flag_counter.get("extra_citation", 0))

    print(json.dumps({
        "quality_log_path": str(path),
        "since": args.since,
        "since_ts": since_ts,
        "rows_total": total,
        "rows_backfilled_n": backfilled_n,
        "rows_original_n": total - backfilled_n,
        "rows_skipped_fixture_or_demo_n": skipped_fixture_or_demo,
        "missing_body_n": missing_body,
        "citation_drift_n": drift,
        "flag_counts": dict(flag_counter),
        "top_expected_citations": [{"path": p, "n": n}
                                     for p, n in expected_paths.most_common(args.top_n)],
        "top_declared_citations": [{"path": p, "n": n}
                                     for p, n in declared_paths.most_common(args.top_n)],
    }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
