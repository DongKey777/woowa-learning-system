#!/usr/bin/env python3
"""bin/reviewer-profile — alias for bin/reviewer (Phase X9, legacy-name parity).

Same functionality as bin/reviewer — kept as separate entry for AI sessions
that look up the legacy wrapper name.
"""
from __future__ import annotations

import os
import runpy
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent

if __name__ == "__main__":
    os.environ.setdefault("PYTHONUNBUFFERED", "1")
    sys.argv = [str(REPO_ROOT / "bin" / "reviewer"), *sys.argv[1:]]
    runpy.run_path(sys.argv[0], run_name="__main__")
