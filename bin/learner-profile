#!/usr/bin/env python3
"""bin/learner-profile {show|recompute|set|clear|redact} (Phase X6).

Sub-commands for the v3 learner profile.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402

PROFILE = "profile.json"


def cmd_show(args) -> int:
    p = args.state_root / "learner" / PROFILE
    if not p.exists():
        print(json.dumps({"missing": True}, ensure_ascii=False, indent=2),
              file=sys.stderr)
        return 1
    print(p.read_text(encoding="utf-8"))
    return 0


def cmd_recompute(args) -> int:
    from core.profile import rebuild_unified_projection, recompute_profile

    profile = recompute_profile(args.learner_id, state_root=args.state_root)
    payload = {
        "computed_at": profile["computed_at"],
        "experience_level": profile["experience_level"],
        "mastered_n": len(profile["concepts"]["mastered"]),
        "events_total": profile["activity"]["events_total"],
    }
    if args.rebuild_unified_projection:
        unified = rebuild_unified_projection(
            args.learner_id,
            state_root=args.state_root,
            profile=profile,
            now=profile.get("computed_at"),
        )
        payload["unified_projection"] = {
            "rebuilt": True,
            "path": str(args.state_root / "learner" / "unified_profile.json"),
            "priority_focus_n": len(
                (unified.get("reconciled") or {}).get("priority_focus") or []
            ),
            "cs_view_present": unified.get("cs_view") is not None,
        }
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


def cmd_set(args) -> int:
    import time

    p = args.state_root / "learner" / PROFILE
    profile = json.loads(p.read_text(encoding="utf-8")) if p.exists() else {
        "schema_version": "v3", "learner_id": args.learner_id, "concepts": {
            "mastered": [], "proficient": [], "uncertain": [], "underexplored": []
        }
    }
    if args.field and args.value:
        concepts = profile.setdefault("concepts", {})
        bucket = concepts.setdefault(args.field, [])
        if args.value not in bucket:
            bucket.append(args.value)
    profile.setdefault("manual_overrides", {})[args.field or "?"] = {
        "value": args.value, "at": time.time()}
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(profile, ensure_ascii=False, indent=2), encoding="utf-8")
    print(json.dumps({"updated": True, "field": args.field, "value": args.value},
                      ensure_ascii=False, indent=2))
    return 0


def cmd_clear(args) -> int:
    import shutil

    if not args.yes:
        print("ERROR: --yes required to confirm destructive clear",
              file=sys.stderr)
        return 2
    target = args.state_root / "learner"
    if target.exists():
        shutil.rmtree(target)
    print(json.dumps({"cleared": True, "path": str(target)},
                      ensure_ascii=False, indent=2))
    return 0


def cmd_redact(args) -> int:
    import re
    import shutil

    pii_patterns = [
        re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"),
        re.compile(r"\bgh[pousr]_[A-Za-z0-9_]{16,}\b"),
    ]
    target_file = args.state_root / "learner" / "history.jsonl"
    if not target_file.exists():
        print(json.dumps({"missing": True}, ensure_ascii=False, indent=2),
              file=sys.stderr)
        return 1
    backup = target_file.with_suffix(".jsonl.bak")
    shutil.copy(target_file, backup)
    redacted_n = 0
    out_lines = []
    for line in target_file.read_text(encoding="utf-8").splitlines():
        new = line
        for pat in pii_patterns:
            new, n = pat.subn("[REDACTED]", new)
            redacted_n += n
        out_lines.append(new)
    target_file.write_text("\n".join(out_lines) + "\n", encoding="utf-8")
    print(json.dumps({"redactions_n": redacted_n, "backup": str(backup)},
                      ensure_ascii=False, indent=2))
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--learner-id", default=None)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    sub = parser.add_subparsers(dest="action", required=True)
    sub.add_parser("show")
    r = sub.add_parser("recompute")
    r.add_argument("--rebuild-unified-projection", action="store_true")
    s = sub.add_parser("set")
    s.add_argument("--field", choices=("mastered", "proficient", "uncertain",
                                         "underexplored"))
    s.add_argument("--value")
    c = sub.add_parser("clear")
    c.add_argument("--yes", action="store_true")
    sub.add_parser("redact")
    args = parser.parse_args(argv)
    args.learner_id = resolve_learner_login(
        args.state_root,
        explicit=args.learner_id,
    )

    return {"show": cmd_show, "recompute": cmd_recompute, "set": cmd_set,
            "clear": cmd_clear, "redact": cmd_redact}[args.action](args)


if __name__ == "__main__":
    raise SystemExit(main())
