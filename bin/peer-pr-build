#!/usr/bin/env python3
"""bin/peer-pr-build — family P builder (repo-scoped).

Learner-vs-peer PR diff comparison on the same mission: the learner's most-recent
PR set next to the most *comparable* peers' PRs (Jaccard file-set similarity),
surfacing common / learner-only / peer-only paths plus the real mentor review
threads on the peers' PRs. Reads state/repos/<repo>/archive/prs.sqlite3 (the
*_current tables via core.archive) and writes state/repos/<repo>/peer_pr.json
(loaded in mode peer_compare). See mission/peer_pr.py for the analysis contract.

Usage:
  bin/peer-pr-build --repo spring-roomescape-waiting [--learner-login DongKey777]
                    [--max-peers 2]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from mission.peer_pr import analyze_repo, save_peer_pr  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--max-peers", type=int, default=2,
                        help="how many most-comparable peers to surface (default 2)")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    report = analyze_repo(args.repo, learner, args.state_root,
                          max_peers=args.max_peers)
    out = save_peer_pr(report, args.state_root)
    if args.silent:
        return 0
    print(json.dumps({"repo": report["repo"], "status": report["status"],
                      "learner_pr": report.get("learner_pr", {}).get("number"),
                      "selection": report.get("selection", []),
                      "counts": report["counts"]},
                     ensure_ascii=False))
    print(f"  wrote: {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
