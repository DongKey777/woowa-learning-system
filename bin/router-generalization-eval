#!/usr/bin/env python3
"""bin/router-generalization-eval — 14-scenario set (Phase J fixture) +
holdout phrases (Phase W11).

Tests router dispatch accuracy on diverse prompts; reports per-mode
accuracy + confusion.
"""
from __future__ import annotations

import json
import sys
from collections import Counter, defaultdict
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core import daemon  # noqa: E402
from core.router import route  # noqa: E402


def _build_cosine_fn():
    """Pure dense top-1 cosine via the warm daemon — mirrors the daemon's own
    _nearest_concept_cosine so the gate fixtures exercise the deployed path.
    Returns None if no daemon is up (gate fixtures then route to tier_0)."""
    if not daemon.ping():
        return None

    def _cosine(text: str) -> float | None:
        hits = daemon.search(text, top_k=1, relations_expand=0, lexical_expand=0)
        if not hits:
            return None
        return float(hits[0].get("score"))

    return _cosine


FIXTURES = [
    # Phase J 14-scenario set
    ("DI가 뭐야", "cs_qa"),
    ("트랜잭션 isolation level", "cs_qa"),
    ("Spring Bean 생명주기", "cs_qa"),
    ("내 ReservationController 리팩토링", "coaching"),
    ("이 코드 어떻게 쓰는 게 맞아", "coaching"),
    ("@Transactional 어디에 붙여", "cs_qa"),
    ("git rebase -i 사용법", "tool_only"),
    ("내 PR 흐름 보여줘", "retro"),
    ("반복 멘토 지적", "retro"),
    # No pending drill: learner asks for practice, so surface cs_qa guidance.
    ("확인 질문 하나 줘", "cs_qa"),
    ("DI 8점", "cs_qa"),              # has CS domain (DI) — definition signal
    ("다른 크루는 어떻게 작성", "f11_anchor"),
    ("PR 390 line 정밀", "f11_anchor"),
    ("안녕", "tool_only"),
    # Holdout (additional)
    ("JdbcTemplate 어떻게 써", "coaching"),
    ("Spring Security OAuth 설정", "cs_qa"),
    ("docker compose up 명령어", "tool_only"),
    ("3 사이클 mentor 지적 패턴", "retro"),
    ("크루 비교해줘", "f11_anchor"),
    ("응", "tool_only"),
    # Phase Y11 P1.1 — guard boundary coverage
    ("오늘 날씨 어때", "tier_0_fallback"),         # non-CS
    ("식당 예약 어떻게", "tier_0_fallback"),       # mission token needs repo
    ("dinner 추천", "tier_0_fallback"),             # short token false-positive
    ("@Transactional 알려줘", "cs_qa"),             # @-prefix boundary
    ("DI가 뭐야", "cs_qa"),                          # Korean josa
    ("Spring Bean 생명주기", "cs_qa"),               # CS phrase (no explicit intent)
    ("JPA n+1 문제 원리", "cs_qa"),                  # short token (n+1) + intent
    # Pillar 2 — semantic router gate rescues genuine CS prompts the lexical
    # CS_TOKENS guard misses (no hardcoded token), via nearest-concept cosine.
    ("MVCC가 뭐야", "cs_qa"),                        # exact-query match, guard blind
    ("격리 수준이 뭐야", "cs_qa"),                    # exact-query match, guard blind
    ("MVCC와 낙관적 락 차이", "cs_qa"),               # paraphrase, cosine >= threshold
    ("낙관적 락이 뭐야", "cs_qa"),                    # paraphrase, cosine >= threshold
    # F1 family H — code-evolution mode (multi-word, before retro)
    ("라운드별 코드 변화 보여줘", "pr_diff_evolution"),
    # F2 family L — cross-mission mode (cross-repo, before retro)
    ("미션 사이에 반복되는 실수 알려줘", "cross_mission"),
    # F2 family M — memory-review mode (spaced-review, before retro)
    ("사각지대 개념 알려줘", "memory_review"),
    # F3 family A+N — received-review mode (before retro)
    ("받은 리뷰 정리해줘", "pr_review"),
    # F3 family C — reviewer-profile mode (repo-gated, before retro).
    # "내" puts the eval into repo-context (repo_keywords) so the repo gate fires.
    ("내 멘토 리뷰 스타일 어때?", "reviewer_profile"),
    # F4 family D — learning-path mode (cross-repo, no repo, before retro)
    ("다음에 뭐 배우면 좋을지 학습 순서 알려줘", "learning_path"),
    # F6 family J — pr-meta mode (repo-gated). "내" puts the eval into
    # repo-context (repo_keywords) so the repo gate fires.
    ("내 PR 너무 큰지 봐줘", "pr_meta"),
    # F5 family G — thread-recon mode (repo-gated). "내" → repo-context.
    ("내 리뷰 스레드 통째로 보여줘", "thread_recon"),
    # F5 family I — temporal mode (repo-gated). "내" → repo-context.
    ("내 리뷰까지 얼마나 걸렸어?", "temporal"),
    # F7 family F — cohort mode (repo-gated). "내" → repo-context.
    ("동기들에 비해 내 PR 어때?", "cohort"),
    # F6 family E — meta-analytics mode (cross-repo, no repo gate).
    ("내가 자주 묻는 개념 뭐야?", "meta_analytics"),
    # F7 family K — predict mode (repo-gated, C+F+H synthesis). "내" → repo-context.
    ("내 PR 올리면 멘토가 뭘 지적할까?", "predict"),
    # B family — cross-crew discoverability (no reimplementation; natural-language
    # entry to the EXISTING f11_anchor mode via the f11 fast-path).
    ("다른 크루 코드 보여줘", "f11_anchor"),
]


def main(argv: list[str] | None = None) -> int:
    # Use repo-context for coaching-relevant prompts
    repo_keywords = {"내", "이 코드", "JdbcTemplate", "리팩토링"}
    cosine_fn = _build_cosine_fn()
    correct = 0
    by_mode_correct: Counter = Counter()
    by_mode_total: Counter = Counter()
    failures = []
    confusion: dict[tuple, int] = defaultdict(int)
    for prompt, expected in FIXTURES:
        repo = "spring-roomescape-member" if any(k in prompt for k in repo_keywords) else None
        decision = route(prompt, repo=repo, nearest_concept_cosine=cosine_fn)
        got = decision.mode
        by_mode_total[expected] += 1
        if got == expected:
            correct += 1
            by_mode_correct[expected] += 1
        else:
            failures.append({"prompt": prompt, "expected": expected, "got": got,
                              "reason": decision.reason})
            confusion[(expected, got)] += 1

    print(json.dumps({
        "total": len(FIXTURES),
        "passed": correct,
        "accuracy": round(correct / len(FIXTURES), 3),
        "per_mode_accuracy": {mode: f"{by_mode_correct[mode]}/{by_mode_total[mode]}"
                               for mode in by_mode_total},
        "failures": failures,
        "confusion_pairs": [{"expected": e, "got": g, "n": n}
                             for (e, g), n in sorted(confusion.items(), key=lambda x: -x[1])],
    }, ensure_ascii=False, indent=2))
    return 0 if correct == len(FIXTURES) else 1


if __name__ == "__main__":
    raise SystemExit(main())
