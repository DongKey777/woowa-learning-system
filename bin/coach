#!/usr/bin/env python3
"""bin/coach — thin wrapper, ensures coaching mode via repo context (Phase V2)."""
from __future__ import annotations

import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent

if __name__ == "__main__":
    # Just hand off to bin/ask --repo R (router picks coaching when keyword matches)
    args = sys.argv[1:]
    os.execv(sys.executable, [sys.executable, str(REPO_ROOT / "bin" / "ask"), *args])
