#!/usr/bin/env python3
"""bin/index-fetch — download pre-built Lance index from GitHub Releases.

학습자 기기에서 로컬 인덱스 빌드는 절대 금지 (M4 15-30분 + 4-6GB RAM).
Maintainer가 RunPod 등에서 빌드 후 publish한 release artifact만 사용.

Default tag: paradigm-v2-index-v1.0.1
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))
DEFAULT_TAG = "paradigm-v2-index-v1.0.1"
DEFAULT_PATTERN = "paradigm-v2-index-v1.0.1.tar.zst"
EXPECTED_SHA256 = "24cc838c949078f767fd41afd7cc50fd865e2a4fb387b2dfcb6cc39ee793bec6"
STATE_DIR = REPO_ROOT / "state"


def _sha256(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def _ensure_runtime_sidecars() -> tuple[int, dict | None]:
    try:
        from rag.corpus_loader import load_corpus, write_corpus_snapshot
        from core.lexical_fusion import (
            _corpus_fingerprint as _dense_corpus_fingerprint,
            preload_lexical_entries,
        )

        corpus = load_corpus(strict=True)
        corpus_stats = write_corpus_snapshot(corpus)
        lexical_stats = preload_lexical_entries(corpus)
        stats = {
            "corpus_snapshot": corpus_stats,
            "lexical_sidecar": lexical_stats,
            "dense_corpus_sha256": _dense_corpus_fingerprint(corpus),
        }
        print(f"[index-fetch] runtime sidecars {stats}", flush=True)
        return 0, stats
    except Exception as exc:  # noqa: BLE001
        print(f"[index-fetch] runtime sidecars failed: {exc}", file=sys.stderr)
        return 6, None


def _manifest_dense_sha(path: Path) -> str | None:
    if not path.exists():
        return None
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return "invalid-json"
    return manifest.get("dense_corpus_sha256") or manifest.get("corpus_sha256")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tag", default=DEFAULT_TAG)
    parser.add_argument("--pattern", default=DEFAULT_PATTERN)
    parser.add_argument("--expected-sha256", default=EXPECTED_SHA256,
                        help="if set, abort on hash mismatch")
    parser.add_argument("--force", action="store_true",
                        help="overwrite state/index/ if already present")
    args = parser.parse_args(argv)

    target = STATE_DIR / "index"
    if target.exists() and not args.force:
        rc, stats = _ensure_runtime_sidecars()
        if rc != 0:
            return rc
        manifest_sha = _manifest_dense_sha(target / "manifest.json")
        current_sha = (stats or {}).get("dense_corpus_sha256")
        if current_sha and manifest_sha != current_sha:
            print(
                "[index-fetch] WARNING: refreshed runtime sidecars but dense "
                f"index manifest is stale (manifest={manifest_sha or 'missing'}, "
                f"current={current_sha}). Run corpus rebuild readiness before "
                "publishing a new index.",
                file=sys.stderr,
            )
        print(f"[index-fetch] state/index/ already exists ({target}). "
              f"Use --force to overwrite.", file=sys.stderr)
        return 0

    # Verify gh CLI present
    try:
        subprocess.run(["gh", "--version"], check=True, capture_output=True)
    except (FileNotFoundError, subprocess.CalledProcessError):
        print("[index-fetch] ERROR: gh CLI 미설치. macOS: brew install gh, "
              "Ubuntu: sudo apt install gh, Windows: winget install GitHub.cli",
              file=sys.stderr)
        return 2

    # Download to temp
    with tempfile.TemporaryDirectory() as tmp:
        tmp_archive = Path(tmp) / args.pattern
        print(f"[index-fetch] downloading {args.tag}/{args.pattern}...", flush=True)
        res = subprocess.run(
            ["gh", "release", "download", args.tag,
             "--repo", "DongKey777/woowa-learning-system",
             "--pattern", args.pattern,
             "--output", str(tmp_archive)],
            capture_output=True, text=True,
        )
        if res.returncode != 0:
            print(f"[index-fetch] gh release download failed:\n{res.stderr}",
                  file=sys.stderr)
            return 2

        if args.expected_sha256:
            got = _sha256(tmp_archive)
            if got != args.expected_sha256:
                print(f"[index-fetch] SHA256 mismatch — expected "
                      f"{args.expected_sha256}, got {got}", file=sys.stderr)
                return 3
            print(f"[index-fetch] SHA256 verified: {got[:16]}…", flush=True)

        # Extract
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if target.exists():
            import shutil
            shutil.rmtree(target)
        print(f"[index-fetch] extracting to {STATE_DIR}/index ...", flush=True)
        # zstd -d | tar -xf -  (portable on BSD tar / GNU tar both)
        zstd_proc = subprocess.Popen(
            ["zstd", "-d", "-c", str(tmp_archive)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        tar_proc = subprocess.Popen(
            ["tar", "-xf", "-", "-C", str(STATE_DIR)],
            stdin=zstd_proc.stdout, stderr=subprocess.PIPE,
        )
        zstd_proc.stdout.close()  # let SIGPIPE propagate cleanly
        tar_stderr = tar_proc.communicate()[1]
        zstd_stderr = zstd_proc.communicate()[1]
        if tar_proc.returncode != 0 or zstd_proc.returncode != 0:
            print(f"[index-fetch] extract failed:\n"
                  f"  zstd: {zstd_stderr.decode(errors='replace')[:200]}\n"
                  f"  tar:  {tar_stderr.decode(errors='replace')[:200]}",
                  file=sys.stderr)
            return 4

    if not (target / "concepts.lance").exists():
        print(f"[index-fetch] post-extract verification failed — "
              f"{target}/concepts.lance not found", file=sys.stderr)
        return 5

    rc, _ = _ensure_runtime_sidecars()
    if rc != 0:
        return rc

    print(f"[index-fetch] ✓ {target}/concepts.lance ready", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
