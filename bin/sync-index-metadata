#!/usr/bin/env python3
"""bin/sync-index-metadata — update state/index/manifest.json + docs
markers to a given release tag (Phase X1).

CLI: bin/sync-index-metadata --tag T
"""
from __future__ import annotations

import argparse
import json
import re
import sys
import time
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
MANIFEST = REPO_ROOT / "state" / "index" / "manifest.json"
DOCS = [REPO_ROOT / "CLAUDE.md", REPO_ROOT / "AGENTS.md",
        REPO_ROOT / "docs" / "bin-reference.md"]

# Version segments are dot-separated; the pattern must not end on a '.' or it
# greedily swallows a trailing sentence period (…v1.0.4. → consumes the period).
INDEX_TAG_PATTERN = re.compile(r"paradigm-v2-index-v[\w\-]+(?:\.[\w\-]+)*")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tag", required=True,
                        help="release tag (e.g. paradigm-v2-index-v1.0.0)")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)

    updates = []

    # 1. manifest
    if MANIFEST.exists():
        m = json.loads(MANIFEST.read_text(encoding="utf-8"))
        m["release_tag"] = args.tag
        m["release_tag_updated_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        if not args.dry_run:
            MANIFEST.write_text(json.dumps(m, ensure_ascii=False, indent=2),
                                  encoding="utf-8")
        updates.append({"file": str(MANIFEST), "action": "tag_set"})

    # 2. docs — replace any paradigm-v2-index-vX.Y.Z tokens
    for doc in DOCS:
        if not doc.exists():
            continue
        text = doc.read_text(encoding="utf-8")
        new_text, n = INDEX_TAG_PATTERN.subn(args.tag, text)
        if n > 0:
            if not args.dry_run:
                doc.write_text(new_text, encoding="utf-8")
            updates.append({"file": str(doc.relative_to(REPO_ROOT)),
                             "replacements": n})

    print(json.dumps({"tag": args.tag, "dry_run": args.dry_run,
                       "updates": updates, "updates_n": len(updates)},
                       ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
