#!/usr/bin/env python3
"""bin/corpus-build — build Lance concept dense index from JSON corpus.

Usage: bin/corpus-build [--corpus-dir PATH] [--index-dir PATH]

M4 16GB note: real BGE-M3 encode of 3199 concepts takes 15-30 min and 4-6GB
RAM. RunPod H100 builds the same index in ~5 min. Output index ≤16MB.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from rag.index import DEFAULT_CORPUS_DIR, DEFAULT_INDEX_DIR, _write_manifest, build_index  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--corpus-dir", type=Path, default=DEFAULT_CORPUS_DIR)
    parser.add_argument("--index-dir", type=Path, default=DEFAULT_INDEX_DIR)
    parser.add_argument("--batch-size", type=int, default=16)
    args = parser.parse_args(argv)

    print(f"Building index: corpus={args.corpus_dir} → index={args.index_dir}")
    report = build_index(
        corpus_dir=args.corpus_dir,
        index_dir=args.index_dir,
        batch_size=args.batch_size,
    )
    _write_manifest(report)
    mb = report.index_size_bytes / 1024 / 1024
    print(f"  concepts: {report.concepts_indexed}")
    print(f"  encode_seconds: {report.elapsed_seconds:.1f}")
    print(f"  size: {mb:.2f} MB")
    print(f"  path: {report.index_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
