#!/usr/bin/env python3
"""bin/list-repos — list onboarded mission repos (Phase U)."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--missions-root", type=Path,
                        default=Path(__file__).resolve().parent.parent / "missions")
    args = parser.parse_args(argv)

    out = []
    state_repos = args.state_root / "repos"
    if state_repos.exists():
        for d in sorted(state_repos.iterdir()):
            if not d.is_dir():
                continue
            archive_present = (d / "archive" / "prs.sqlite3").exists()
            mission_patterns = (d / "mission_patterns.json").exists()
            cross_crew = (d / "cross_crew_review_graph.parquet").exists()
            clone_present = (args.missions_root / d.name).exists()
            out.append({
                "name": d.name,
                "archive_present": archive_present,
                "mission_patterns_built": mission_patterns,
                "cross_crew_built": cross_crew,
                "mission_clone_present": clone_present,
            })
    print(json.dumps({"repos_n": len(out), "repos": out}, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
