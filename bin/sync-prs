#!/usr/bin/env python3
"""bin/sync-prs — incremental PR archive sync (Phase U).

Uses last collection_runs.finished_at as --since cursor when not given.

CLI: bin/sync-prs --repo R --owner O [--since ISO] [--limit N] [--silent]
"""
from __future__ import annotations

import argparse
import json
import sqlite3
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from scripts.collection.collect_prs import collect  # noqa: E402


def _last_run_ts(db_path: Path) -> str | None:
    if not db_path.exists():
        return None
    conn = sqlite3.connect(str(db_path))
    try:
        r = conn.execute(
            "SELECT finished_at FROM collection_runs "
            "WHERE status = 'succeeded' ORDER BY id DESC LIMIT 1"
        ).fetchone()
        return r[0] if r else None
    except sqlite3.OperationalError:
        return None
    finally:
        conn.close()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--owner", required=True)
    parser.add_argument("--gh-repo", default=None)
    parser.add_argument("--since", default=None,
                        help="ISO timestamp; defaults to last successful run")
    parser.add_argument("--limit", type=int, default=None)
    parser.add_argument("--max-gh-calls", type=int, default=200)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    db_path = args.state_root / "repos" / args.repo / "archive" / "prs.sqlite3"
    since = args.since or _last_run_ts(db_path)
    if since is None:
        print("ERROR: no prior collection run — use bin/bootstrap-repo first",
              file=sys.stderr)
        return 2

    gh_repo = args.gh_repo or args.repo
    try:
        report = collect(
            owner=args.owner, repo=gh_repo, db_path=db_path,
            mode="incremental", since=since, limit=args.limit,
            max_calls=args.max_gh_calls,
        )
    except Exception as e:
        print(f"ERROR: {type(e).__name__}: {e}", file=sys.stderr)
        return 2

    if not args.silent:
        print(json.dumps({
            "repo": args.repo, "since": since,
            "status": report.finished_status,
            "prs_processed": report.prs_processed,
            "review_comments_upserted": report.review_comments_upserted,
            "gh_calls_used": report.gh_calls_used,
        }, ensure_ascii=False, indent=2))
    return 0 if report.finished_status == "succeeded" else 1


if __name__ == "__main__":
    raise SystemExit(main())
