#!/usr/bin/env python3
"""bin/sync-prs — incremental PR archive sync (Phase U).

Uses last collection_runs.finished_at as --since cursor when not given.

CLI: bin/sync-prs --repo R --owner O [--since ISO] [--limit N] [--silent]
"""
from __future__ import annotations

import argparse
import json
import sqlite3
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from scripts.collection.collect_prs import collect  # noqa: E402


def _last_run_ts(db_path: Path) -> str | None:
    if not db_path.exists():
        return None
    conn = sqlite3.connect(str(db_path))
    try:
        # Partial runs now advance the cursor (finished_at = last collected PR's
        # updated_at), so they count too — otherwise a capped run could never
        # make forward progress.
        r = conn.execute(
            "SELECT finished_at FROM collection_runs "
            "WHERE status IN ('succeeded', 'partial') AND finished_at IS NOT NULL "
            "ORDER BY id DESC LIMIT 1"
        ).fetchone()
        return r[0] if r else None
    except sqlite3.OperationalError:
        return None
    finally:
        conn.close()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--owner", default=None,
                        help="upstream owner; default: auto-detect via "
                             "gh repo view <learner>/<repo> parent, else 'woowacourse'")
    parser.add_argument("--gh-repo", default=None)
    parser.add_argument("--since", default=None,
                        help="ISO timestamp; defaults to last successful run")
    parser.add_argument("--limit", type=int, default=None)
    parser.add_argument("--max-gh-calls", type=int, default=None,
                        help="gh call budget; default auto-derives from the live "
                             "authenticated REST limit (gh api rate_limit)")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    db_path = args.state_root / "repos" / args.repo / "archive" / "prs.sqlite3"
    since = args.since or _last_run_ts(db_path)
    if since is None:
        print("ERROR: no prior collection run — use bin/bootstrap-repo first",
              file=sys.stderr)
        return 2

    gh_repo = args.gh_repo or args.repo
    # Auto-resolve owner via learner identity + gh repo view parent
    if args.owner:
        owner = args.owner
    else:
        from core.identity import resolve_learner_login
        learner = resolve_learner_login(args.state_root)
        # Inline _detect_upstream_owner (same as bin/onboard-repo)
        owner = None
        try:
            import subprocess
            r = subprocess.run(
                ["gh", "repo", "view", f"{learner}/{args.repo}", "--json", "parent"],
                capture_output=True, text=True, timeout=10,
            )
            if r.returncode == 0:
                parent = json.loads(r.stdout).get("parent")
                if isinstance(parent, dict):
                    owner = (parent.get("owner") or {}).get("login")
        except Exception:
            pass
        if not owner:
            owner = "woowacourse"

    try:
        report = collect(
            owner=owner, repo=gh_repo, db_path=db_path,
            mode="incremental", since=since, limit=args.limit,
            max_calls=args.max_gh_calls,
        )
    except Exception as e:
        print(f"ERROR: {type(e).__name__}: {e}", file=sys.stderr)
        return 2

    refresh_steps = []
    # Auto-refresh downstream artifacts when new data arrived
    if report.prs_processed > 0 or report.review_comments_upserted > 0:
        import subprocess
        for step, cmd in [
            ("mission-patterns-build", [sys.executable, str(REPO_ROOT / "bin" / "mission-patterns-build"),
                                         "--repo", args.repo, "--silent"]),
            ("anchors-build", [sys.executable, str(REPO_ROOT / "bin" / "anchors-build"),
                                "--repo", args.repo, "--silent"]),
            ("cross-crew-build", [sys.executable, str(REPO_ROOT / "bin" / "cross-crew-build"),
                                    "--repo", args.repo]),
            ("pr-diff-evolution-build", [sys.executable, str(REPO_ROOT / "bin" / "pr-diff-evolution-build"),
                                          "--repo", args.repo, "--silent"]),
            # received-review surface: reads the anchors refreshed above + archive
            ("learn-pr-review-build", [sys.executable, str(REPO_ROOT / "bin" / "learn-pr-review-build"),
                                        "--repo", args.repo, "--silent"]),
            # reviewer-profile surface: per-repo mentor style/habits from the archive
            ("reviewer-profile-build", [sys.executable, str(REPO_ROOT / "bin" / "reviewer-profile-build"),
                                         "--repo", args.repo, "--silent"]),
            # pr-meta surface: per-repo PR body/size/commit-cohesion hygiene from archive columns
            ("learn-pr-meta-build", [sys.executable, str(REPO_ROOT / "bin" / "learn-pr-meta-build"),
                                     "--repo", args.repo, "--silent"]),
            # thread-recon surface: per-repo received-review reply chains from archive
            ("learn-thread-recon-build", [sys.executable, str(REPO_ROOT / "bin" / "learn-thread-recon-build"),
                                          "--repo", args.repo, "--silent"]),
            # temporal surface: per-repo review-cycle timing (first review/merge/stalls)
            ("learn-temporal-build", [sys.executable, str(REPO_ROOT / "bin" / "learn-temporal-build"),
                                      "--repo", args.repo, "--silent"]),
            # cohort surface: per-repo learner-vs-cohort PR size/review percentiles
            ("learn-cohort-build", [sys.executable, str(REPO_ROOT / "bin" / "learn-cohort-build"),
                                    "--repo", args.repo, "--silent"]),
            # predict surface: synthesizes the reviewer-profile + cohort +
            # pr-diff-evolution artifacts built above into a pre-push review
            # prediction. MUST run after all three of its inputs.
            ("learn-predict-build", [sys.executable, str(REPO_ROOT / "bin" / "learn-predict-build"),
                                     "--repo", args.repo, "--silent"]),
            ("learn-evidence-sync", [sys.executable, str(REPO_ROOT / "bin" / "learn-evidence-sync"),
                                     "--repo", args.repo, "--silent"]),
            # Re-project the consumed profile.json from the mastery just promoted
            # by evidence-sync — without this, daemon/coaching read stale mastery
            # until the next 10-turn recompute (sync's intent only half-realized).
            # Non-destructive (preserves pending_triggers/drill_due). ~40ms.
            ("profile-recompute", [sys.executable, str(REPO_ROOT / "bin" / "profile-recompute"),
                                   "--silent"]),
            # cross-repo: rebuild the all-missions view once, AFTER evidence-sync
            # (it reads the pr_merge/mentor_accept evidence emitted above). Not a
            # per-repo step — no --repo.
            ("learn-cross-mission-build", [sys.executable, str(REPO_ROOT / "bin" / "learn-cross-mission-build"),
                                           "--silent"]),
            # cross-repo: rebuild the memory-review view once (blind spots +
            # forgetting + review cards). Reads mastery/history/anchors across
            # all missions — no --repo.
            ("learn-memory-review-build", [sys.executable, str(REPO_ROOT / "bin" / "learn-memory-review-build"),
                                           "--silent"]),
            # cross-repo: rebuild the learning-path recommendation once (concept
            # graph prereq/next traversal + mastery join). No --repo.
            ("learn-learning-path-build", [sys.executable, str(REPO_ROOT / "bin" / "learn-learning-path-build"),
                                           "--silent"]),
            # cross-repo: rebuild the meta-analytics view once (repeated-question
            # concepts + mode-mix + quality-trend + mastery snapshot over the
            # whole ask history). No --repo.
            ("learn-meta-analytics-build", [sys.executable, str(REPO_ROOT / "bin" / "learn-meta-analytics-build"),
                                            "--silent"]),
        ]:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
            refresh_steps.append({"step": step, "rc": r.returncode})

    if not args.silent:
        print(json.dumps({
            "repo": args.repo, "since": since,
            "status": report.finished_status,
            "prs_processed": report.prs_processed,
            "review_comments_upserted": report.review_comments_upserted,
            "gh_calls_used": report.gh_calls_used,
            "gh_call_budget": report.gh_call_budget,
            "downstream_refresh": refresh_steps,
        }, ensure_ascii=False, indent=2))
    return 0 if report.finished_status == "succeeded" else 1


if __name__ == "__main__":
    raise SystemExit(main())
