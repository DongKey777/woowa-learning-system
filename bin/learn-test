#!/usr/bin/env python3
"""bin/learn-test — ingest JUnit XML test results (Phase T3).

AI session calls after `./gradlew test` finishes. Walks --path for *.xml,
parses with stdlib xml.etree, appends test_result events to history.jsonl.
Idempotent — re-run on same XML dir produces 0 duplicates (stable event_id).

Usage:
  bin/learn-test --path missions/<r>/build/test-results/test/ [--repo R] [--silent]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.junit_ingest import ingest_junit_dir  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--path", required=True, type=Path)
    parser.add_argument("--repo", default=None)
    parser.add_argument("--learner-id", default="default")
    parser.add_argument("--mode", default="learning",
                        choices=("learning", "development", "test"))
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    report = ingest_junit_dir(
        args.path, repo=args.repo, state_root=args.state_root,
        learner_id=args.learner_id, mode=args.mode,
    )
    if not args.silent:
        print(json.dumps({
            "xml_dir": report.xml_dir,
            "files_scanned": report.files_scanned,
            "cases_total": report.cases_total,
            "cases_passed": report.cases_passed,
            "cases_failed": report.cases_failed,
            "cases_skipped": report.cases_skipped,
            "events_appended": report.events_appended,
            "events_skipped_dup": report.events_skipped_dup,
            "inferred_uncertain_concepts": report.inferred_uncertain_concepts,
        }, ensure_ascii=False, indent=2))
    return 0 if report.files_scanned > 0 else 2


if __name__ == "__main__":
    raise SystemExit(main())
