#!/usr/bin/env python3
"""bin/profile-recompute — derive learner profile.json v3 (Phase T6).

Scans history.jsonl + mastery_graph.sqlite → overwrites state/learner/profile.json.

CLI: bin/profile-recompute [--learner-id L] [--state-root P] [--silent]
                         [--rebuild-unified-projection]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.profile import rebuild_unified_projection, recompute_profile  # noqa: E402
from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--learner-id", default=None)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--rebuild-unified-projection", action="store_true",
                        help="also rebuild state/learner/unified_profile.json")
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner_id = resolve_learner_login(args.state_root, explicit=args.learner_id)
    profile = recompute_profile(learner_id, state_root=args.state_root)
    unified = None
    if args.rebuild_unified_projection:
        unified = rebuild_unified_projection(
            learner_id,
            state_root=args.state_root,
            profile=profile,
            now=profile.get("computed_at"),
        )
    if not args.silent:
        c = profile["concepts"]
        a = profile["activity"]
        payload = {
            "learner_id": profile["learner_id"],
            "experience_level": profile["experience_level"],
            "events_total": a["events_total"],
            "days_active": a["days_active"],
            "mastered_n": len(c["mastered"]),
            "proficient_n": len(c["proficient"]),
            "uncertain_n": len(c["uncertain"]),
            "underexplored_n": len(c["underexplored"]),
            "recent_code_24h": profile["recent_code_changes_24h"],
            "next_recommendations": [r["concept_id"] for r in profile["next_recommendations"]],
        }
        if unified is not None:
            payload["unified_projection"] = {
                "rebuilt": True,
                "path": str(args.state_root / "learner" / "unified_profile.json"),
                "priority_focus_n": len(
                    (unified.get("reconciled") or {}).get("priority_focus") or []
                ),
                "cs_view_present": unified.get("cs_view") is not None,
            }
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
