#!/usr/bin/env python3
"""bin/anchors-build — extract review anchors for a repo + merge into
state/learner/review_anchors.json (Phase Y6 fix).

Closes the gap in bin/onboard-repo where anchor extraction was missing,
causing bin/cross-crew-build to produce 0 rows.

CLI: bin/anchors-build --repo R [--learner-login L] [--limit N] [--silent]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from anchors.extract import (  # noqa: E402
    MAX_ANCHORS, extract_from_archive, load_anchors, save_anchors,
)
from core.identity import resolve_learner_login  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--learner-login", default=None,
                        help="default: auto-detect via gh CLI + cache")
    parser.add_argument("--limit", type=int, default=MAX_ANCHORS)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner = resolve_learner_login(args.state_root, explicit=args.learner_login)
    # Extract for this repo
    new_anchors = extract_from_archive(
        repo=args.repo, learner_login=learner,
        archive_root=args.state_root, limit=args.limit,
    )
    # Merge with existing (preserve other repos' anchors)
    existing = load_anchors(state_root=args.state_root)
    other_repo = [a for a in existing if a.repo != args.repo]
    merged = other_repo + new_anchors

    out = save_anchors(merged, state_root=args.state_root)
    if not args.silent:
        from collections import Counter
        c = Counter(a.repo for a in merged)
        print(json.dumps({
            "repo": args.repo,
            "new_anchors_for_repo": len(new_anchors),
            "preserved_other_repo_anchors": len(other_repo),
            "merged_total": len(merged),
            "per_repo": dict(c),
            "out_path": str(out),
        }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
