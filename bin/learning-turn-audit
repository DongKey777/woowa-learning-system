#!/usr/bin/env python3
"""bin/learning-turn-audit — verify history.jsonl turn integrity (Phase W4).

For each rag_ask event in the last N turns, check:
- payload has prompt + router_mode
- ts is non-zero
- if response_quality.jsonl has matching source_event_id (telemetry joined)
- optionally require response-quality/full-body capture for each sampled turn
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.state import DEFAULT_STATE_ROOT  # noqa: E402
from scripts.mining.jsonl_iter import is_backfilled, iter_jsonl  # noqa: E402


EXCLUDED_PENDING_STATUSES = {
    "superseded_by_later_capture",
    "ignored_non_learning",
    "abandoned_interrupted",
}


def _load_pending_index(state_root: Path) -> dict[str, dict]:
    root = state_root / "learner" / "pending-captures"
    if not root.exists():
        return {}
    out: dict[str, dict] = {}
    for path in root.glob("*.json"):
        try:
            row = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            continue
        source_event_id = row.get("source_event_id")
        if source_event_id:
            out[str(source_event_id)] = row
    return out


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--last", type=int, default=100)
    parser.add_argument("--require-response-quality", action="store_true")
    parser.add_argument("--require-full-body", action="store_true")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    args = parser.parse_args(argv)

    history = args.state_root / "learner" / "history.jsonl"
    quality = args.state_root / "learner" / "response-quality.jsonl"

    # Build response-quality index by source_event_id
    quality_rows = list(iter_jsonl(
        quality,
        exclude_modes=("development", "test"),
    ))
    quality_index = {r.get("source_event_id"): r for r in quality_rows
                      if r.get("source_event_id")}
    pending_index = _load_pending_index(args.state_root)

    all_rag = list(iter_jsonl(
        history,
        event_type="rag_ask",
        exclude_modes=("development", "test"),
    ))
    sample = all_rag[-args.last:]

    issues: list[dict] = []
    excluded_status_counts: dict[str, int] = {}
    for ev in sample:
        eid = ev.get("event_id")
        payload = ev.get("payload") or {}
        pending_status = (pending_index.get(str(eid)) or {}).get("status")
        excluded = pending_status in EXCLUDED_PENDING_STATUSES
        if excluded:
            excluded_status_counts[pending_status] = (
                excluded_status_counts.get(pending_status, 0) + 1
            )
        evt_issues = []
        if not payload.get("prompt"):
            evt_issues.append("missing_prompt")
        if not payload.get("router_mode"):
            evt_issues.append("missing_router_mode")
        if not ev.get("ts"):
            evt_issues.append("missing_ts")
        row = quality_index.get(eid)
        if (
            not excluded
            and (args.require_response_quality or args.require_full_body)
            and row is None
        ):
            evt_issues.append("missing_response_quality")
        if not excluded and args.require_full_body:
            if row is None:
                pass
            elif not row.get("response_body_path") or row.get("response_length_chars", 0) <= 0:
                evt_issues.append("missing_full_response_body")
            elif not (args.state_root / row["response_body_path"]).exists():
                evt_issues.append("missing_response_body_file")
        if evt_issues:
            issues.append({"event_id": eid, "issues": evt_issues})

    auditable_sample = [
        ev for ev in sample
        if (pending_index.get(str(ev.get("event_id"))) or {}).get("status")
        not in EXCLUDED_PENDING_STATUSES
    ]
    joined_n = sum(1 for ev in auditable_sample if ev.get("event_id") in quality_index)
    full_body_joined_n = sum(
        1 for ev in auditable_sample
        if (row := quality_index.get(ev.get("event_id")))
        and row.get("response_body_path")
        and int(row.get("response_length_chars") or 0) > 0
    )

    print(json.dumps({
        "history_path": str(history),
        "rag_ask_total": len(all_rag),
        "audited_last_n": len(sample),
        "auditable_n": len(auditable_sample),
        "excluded_pending_n": len(sample) - len(auditable_sample),
        "excluded_pending_status_counts": excluded_status_counts,
        "issues_n": len(issues),
        "issues_sample": issues[:10],
        "response_quality_joined": joined_n,
        "join_rate_pct": round(joined_n / max(1, len(auditable_sample)) * 100, 1),
        "full_body_joined": full_body_joined_n,
        "full_body_join_rate_pct": round(
            full_body_joined_n / max(1, len(auditable_sample)) * 100,
            1,
        ),
        "missing_response_quality_n": len(auditable_sample) - joined_n,
        "missing_full_body_n": len(auditable_sample) - full_body_joined_n,
        "rows_backfilled_n": sum(1 for ev in sample if is_backfilled(ev)),
        "quality_rows_total": len(quality_rows),
    }, ensure_ascii=False, indent=2))
    return 0 if not issues else 1


if __name__ == "__main__":
    raise SystemExit(main())
