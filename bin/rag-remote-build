#!/usr/bin/env python3
"""bin/rag-remote-build — thin wrapper invoking scripts/remote_build.py
(Phase X10). Existing module already handles RunPod r1/r2/r3 build.

CLI: bin/rag-remote-build [--dry-run] [--r-phase r1|r2|r3]
"""
from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
TARGET = REPO_ROOT / "scripts" / "remote_build.py"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--r-phase", choices=("r1", "r2", "r3"), default="r1")
    args, extra = parser.parse_known_args(argv)

    if not TARGET.exists():
        print(json.dumps({"missing_module": str(TARGET),
                           "note": "remote_build script not yet implemented; "
                                    "use index-fetch for learners"},
                          ensure_ascii=False, indent=2), file=sys.stderr)
        return 2 if not args.dry_run else 0

    cmd = [sys.executable, str(TARGET)]
    if args.dry_run:
        cmd.append("--dry-run")
    cmd.extend(extra)
    return subprocess.call(cmd, cwd=REPO_ROOT)


# Avoid ImportError on dry-run when json is referenced only in error path
import json  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
