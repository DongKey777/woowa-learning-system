#!/usr/bin/env python3
"""bin/learn-response-quality — response telemetry recorder (Phase T4).

AI session auto-calls after every coach turn answer:
  bin/learn-response-quality --source-event-id <id> --response-summary "..." \\
     --response-file - --expected-citation <c1> --declared-citation <c2> \\
     --quality-flag <flag> --silent

Body via stdin (--response-file -) is preferred. Without body, summary_only
mode flags `missing_response_body`.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.response_quality import record_response_quality  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402


def _read_response(args) -> str | None:
    if args.response_text is not None:
        return args.response_text
    if args.response_file == "-":
        return sys.stdin.read()
    if args.response_file:
        return Path(args.response_file).read_text(encoding="utf-8")
    return None


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source-event-id", required=True)
    parser.add_argument("--response-summary", required=True)
    parser.add_argument("--response-file", default=None,
                        help="path or '-' for stdin")
    parser.add_argument("--response-text", default=None,
                        help="literal body string (alternative to --response-file)")
    parser.add_argument("--expected-citation", action="append", default=[])
    parser.add_argument("--declared-citation", action="append", default=[])
    parser.add_argument("--quality-flag", action="append", default=[])
    parser.add_argument("--contract-flag", action="append", default=[])
    parser.add_argument("--repo", default=None)
    parser.add_argument("--turn-id", default=None)
    parser.add_argument("--learner-id", default="default")
    parser.add_argument("--summary-only", action="store_true",
                        help="explicit partial telemetry (no body required)")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    body = _read_response(args)
    if body is None and not args.summary_only:
        print("ERROR: --response-file or --response-text required (or --summary-only)",
              file=sys.stderr)
        return 2

    row = record_response_quality(
        source_event_id=args.source_event_id,
        response_summary=args.response_summary,
        response_body=body,
        expected_citation_paths=args.expected_citation,
        declared_citation_paths=args.declared_citation,
        quality_flags=args.quality_flag,
        contract_flags=args.contract_flag,
        repo=args.repo, turn_id=args.turn_id,
        learner_id=args.learner_id, state_root=args.state_root,
    )
    if not args.silent:
        print(json.dumps({
            "source_event_id": row["source_event_id"],
            "turn_id": row["turn_id"],
            "response_length_chars": row["response_length_chars"],
            "quality_flags": row["quality_flags"],
        }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
