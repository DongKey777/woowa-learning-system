#!/usr/bin/env python3
"""bin/learn-response-quality — response telemetry recorder (Phase T4).

AI session auto-calls after every coach turn answer.

Full mode:
  bin/learn-response-quality --source-event-id <id> --response-summary "..." \\
     --response-file - --expected-citation <c1> --declared-citation <c2> \\
     --quality-flag <flag> --silent

Token-efficient full mode:
  bin/learn-response-quality --source-event-id <id> --response-path /path/answer.md \\
     --expected-citation <c1> --silent

  If --response-summary is omitted but a body is supplied, a short summary is
  derived from the body. If --declared-citation is omitted, citations are
  extracted from the body's final `참고:` block.

Minimal mode (fallback only):
  bin/learn-response-quality --source-event-id <id> --minimal --silent
  → response_summary auto-filled, body skipped (missing_response_body flag),
    expected/declared citations auto-extracted from source rag_ask event's
    top_concept_ids in history.jsonl. AI only needs the source-event-id.

Body via local path (--response-path or --response-file <path>) is preferred
when the host can materialize the final answer without echoing it into the AI
session transcript. Stdin (--response-file -) is a compatibility fallback.
The body must be the exact full learner-facing answer, not a summary.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.response import parse_response  # noqa: E402
from core.response_quality import record_response_quality  # noqa: E402
from core.identity import resolve_learner_login  # noqa: E402
from core.response_capture import append_repair_queue, load_source_event  # noqa: E402
from core.state import DEFAULT_STATE_ROOT  # noqa: E402

SHORT_BODY_MIN_CHARS = 500


def _derive_summary(body: str | None) -> str:
    if not body:
        return "auto-recorded full response"
    candidate_lines: list[str] = []
    for raw in body.splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("# response_"):
            continue
        if line.startswith("[Mode:"):
            continue
        if line == "참고:" or line.startswith("- "):
            continue
        candidate_lines.append(line)
        if len(" ".join(candidate_lines)) >= 120:
            break
    summary = " ".join(candidate_lines) or "auto-recorded full response"
    return " ".join(summary.split())[:300]


def _body_sources(args) -> list[str]:
    sources: list[str] = []
    if args.response_text is not None:
        sources.append("text")
    if args.response_file is not None:
        sources.append("file")
    if args.response_path is not None:
        sources.append("path")
    return sources


def _read_response(args) -> str | None:
    if args.response_text is not None:
        return args.response_text
    if args.response_path:
        return Path(args.response_path).read_text(encoding="utf-8")
    if args.response_file == "-":
        return sys.stdin.read()
    if args.response_file:
        return Path(args.response_file).read_text(encoding="utf-8")
    return None


def _capture_method(args, body: str | None) -> str:
    if args.minimal:
        return "minimal"
    if args.summary_only and not body:
        return "summary_only"
    if args.response_text is not None:
        return "text"
    if args.response_path is not None:
        return "file_path"
    if args.response_file == "-":
        return "stdin"
    if args.response_file:
        return "file_path"
    return "none"


def _capture_input_chars(args, body: str | None) -> int:
    if args.response_text is not None or args.response_file == "-":
        return len(body or "")
    if args.response_path:
        return len(str(args.response_path))
    if args.response_file:
        return len(str(args.response_file))
    return len(args.response_summary or "")


def _body_contract_flags(body: str | None, expected: list[str]) -> list[str]:
    if not body or not body.strip():
        return []
    stripped = body.strip()
    flags: list[str] = []
    if not stripped.startswith("[Mode:"):
        flags.append("missing_mode_header")
    if expected and len(stripped) < SHORT_BODY_MIN_CHARS:
        flags.append("possible_summary_body")
    return flags


def _lookup_source_event(state_root: Path, learner_id: str,
                          source_event_id: str) -> dict | None:
    """Find the rag_ask event with matching event_id in history.jsonl.

    Returns the parsed event dict or None.
    """
    return load_source_event(source_event_id, state_root=state_root)


def _extract_citations_from_event(ev: dict) -> tuple[list[str], str | None]:
    """Pull (top_concept_ids, repo) from a rag_ask event under either the
    new payload-based schema or the legacy top-level schema.
    """
    payload = ev.get("payload") or {}
    cids = payload.get("top_concept_ids") or ev.get("top_paths") or []
    repo = payload.get("repo") or ev.get("repo_context")
    return [c for c in cids if isinstance(c, str)], repo


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source-event-id", required=True)
    parser.add_argument("--response-summary", default=None,
                        help="optional when --response-file/--response-text "
                             "is supplied; derived from body if omitted")
    parser.add_argument("--response-file", default=None,
                        help="path or '-' for stdin")
    parser.add_argument("--response-path", default=None,
                        help="token-efficient alias for --response-file <path>")
    parser.add_argument("--response-text", default=None,
                        help="literal body string (alternative to --response-file)")
    parser.add_argument("--expected-citation", action="append", default=[])
    parser.add_argument("--declared-citation", action="append", default=[])
    parser.add_argument("--quality-flag", action="append", default=[])
    parser.add_argument("--contract-flag", action="append", default=[])
    parser.add_argument("--repo", default=None)
    parser.add_argument("--turn-id", default=None)
    parser.add_argument("--learner-id", default=None)
    parser.add_argument("--summary-only", action="store_true",
                        help="explicit partial telemetry (no body required)")
    parser.add_argument("--minimal", action="store_true",
                        help="auto-fill summary + extract citations from "
                             "source rag_ask event. Only --source-event-id "
                             "required from caller.")
    parser.add_argument("--allow-orphan", action="store_true",
                        help="test/repair only: allow source_event_id without "
                             "a matching rag_ask event")
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    learner_id = resolve_learner_login(args.state_root, explicit=args.learner_id)
    sources = _body_sources(args)
    if len(sources) > 1:
        print("ERROR: use only one body source among --response-file, "
              "--response-path, --response-text",
              file=sys.stderr)
        return 2

    ev = _lookup_source_event(args.state_root, learner_id, args.source_event_id)
    if ev is None and not args.allow_orphan:
        mode = os.environ.get("WOOWA_SESSION_MODE", "learning")
        if mode == "learning":
            append_repair_queue(
                "orphan_source_event",
                state_root=args.state_root,
                source_event_id=args.source_event_id,
                client="learn-response-quality",
                details={"body_source": sources[0] if sources else None},
            )
            print(
                "ERROR: source_event_id does not match a learning rag_ask event "
                "(use --allow-orphan only for tests/repair)",
                file=sys.stderr,
            )
            return 2
    if ev is not None:
        cids, ev_repo = _extract_citations_from_event(ev)
        top3 = cids[:3]
        if not args.expected_citation:
            args.expected_citation = list(top3)
        if args.repo is None:
            args.repo = ev_repo

    if args.minimal:
        if ev is not None:
            # Use top 3 concept_ids as both expected and declared (AI declared
            # what the prompt was routed to).
            if not args.declared_citation:
                args.declared_citation = list(top3)
        if args.response_summary is None:
            args.response_summary = "auto-recorded (minimal mode)"
        # body intentionally skipped — missing_response_body flag will fire
        body = None
    else:
        body = _read_response(args)
        if body is None and not args.summary_only:
            print("ERROR: --response-file or --response-text required "
                  "(or --response-path, --summary-only, or --minimal)",
                  file=sys.stderr)
            return 2
        if args.response_summary is None:
            args.response_summary = (
                "auto-recorded (summary-only; body not captured)"
                if args.summary_only and body is None
                else _derive_summary(body)
            )
        if args.summary_only and body is None:
            if "body_not_captured" not in args.contract_flag:
                args.contract_flag.append("body_not_captured")
            if "token_efficient_summary_only" not in args.contract_flag:
                args.contract_flag.append("token_efficient_summary_only")
            if args.expected_citation and not args.declared_citation:
                args.declared_citation = list(args.expected_citation)
                if "declared_citation_unverified" not in args.contract_flag:
                    args.contract_flag.append("declared_citation_unverified")
        if body and not args.declared_citation:
            args.declared_citation = parse_response(body).citations
        args.contract_flag.extend(_body_contract_flags(body, args.expected_citation))

    capture_method = _capture_method(args, body)
    row = record_response_quality(
        source_event_id=args.source_event_id,
        response_summary=args.response_summary,
        response_body=body,
        expected_citation_paths=args.expected_citation,
        declared_citation_paths=args.declared_citation,
        quality_flags=args.quality_flag,
        contract_flags=args.contract_flag,
        repo=args.repo, turn_id=args.turn_id,
        learner_id=learner_id, state_root=args.state_root,
        capture_method=capture_method,
        capture_input_chars=_capture_input_chars(args, body),
    )
    if not args.silent:
        print(json.dumps({
            "source_event_id": row["source_event_id"],
            "turn_id": row["turn_id"],
            "response_length_chars": row["response_length_chars"],
            "response_body_path": row["response_body_path"],
            "capture_method": row["capture_method"],
            "quality_flags": row["quality_flags"],
            "contract_flags": row["contract_flags"],
        }, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
