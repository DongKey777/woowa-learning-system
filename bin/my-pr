#!/usr/bin/env python3
"""bin/my-pr — coaching scoped to learner's target PR (Phase V3).

CLI: bin/my-pr --repo R [--pr-number N] [--silent]
Wraps coach-run with prompt prefixed by "내 PR 분석".
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--pr-number", type=int, default=None)
    parser.add_argument("--silent", action="store_true")
    args = parser.parse_args(argv)

    pr_clause = f" (PR #{args.pr_number})" if args.pr_number else ""
    prompt = f"내 PR{pr_clause} 코드 분석해줘"
    cmd = [sys.executable, str(REPO_ROOT / "bin" / "coach-run"),
            "--repo", args.repo, "--prompt", prompt]
    if args.silent:
        cmd.append("--silent")
    return subprocess.call(cmd)


if __name__ == "__main__":
    raise SystemExit(main())
