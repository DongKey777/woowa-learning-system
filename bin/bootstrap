#!/usr/bin/env python3
"""bin/bootstrap — paradigm-v2 system-level bootstrap (Phase U).

Runs First-Run Protocol step 1-6:
  1. bin/setup (.venv + pip install -e .) if deps missing
  2. (HF model warm-up happens on first daemon ask)
  3. bin/index-fetch (release artifact)
  4. bin/rag-daemon start
  5. (optional) doctor + validate-state

CLI: bin/bootstrap [--skip-pip] [--skip-index] [--skip-daemon]
"""
from __future__ import annotations

import argparse
import importlib.util
import json
import shutil
import subprocess
import sys
import time
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))


def _run(cmd: list[str], cwd: Path = REPO_ROOT, timeout: float = 600) -> dict:
    t0 = time.perf_counter()
    try:
        r = subprocess.run(cmd, cwd=str(cwd), capture_output=True, text=True,
                            timeout=timeout)
        return {"cmd": " ".join(cmd), "rc": r.returncode,
                "ms": round((time.perf_counter() - t0) * 1000, 1),
                "stderr_tail": (r.stderr or "")[-300:]}
    except subprocess.TimeoutExpired:
        return {"cmd": " ".join(cmd), "rc": 124, "ms": -1, "error": "timeout"}


def _interp_has_deps(interp: Path) -> bool:
    try:
        r = subprocess.run(
            [str(interp), "-c", "import sentence_transformers"],
            capture_output=True, text=True, timeout=30,
        )
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def _daemon_alive() -> bool:
    r = subprocess.run(
        [sys.executable, str(REPO_ROOT / "bin" / "rag-daemon"), "ping"],
        cwd=str(REPO_ROOT), capture_output=True, text=True, timeout=2,
    )
    return r.returncode == 0 and "alive" in r.stdout


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--skip-pip", action="store_true")
    parser.add_argument("--skip-index", action="store_true")
    parser.add_argument("--skip-daemon", action="store_true")
    args = parser.parse_args(argv)

    steps: list[dict] = []

    # 1. dependency setup (idempotent). bin/setup creates a repo-local .venv and
    # installs there, so it works on PEP 668 externally-managed system Python
    # (macOS Homebrew / Debian) without --break-system-packages. Skip entirely
    # when deps already import on this interpreter (maintainer system-Python
    # setup) or when an existing .venv already has them.
    if not args.skip_pip:
        venv_py = REPO_ROOT / ".venv" / "bin" / "python"
        if importlib.util.find_spec("sentence_transformers") is not None:
            steps.append({"step": "setup", "rc": 0, "ms": 0, "skipped": "deps present"})
        elif venv_py.exists() and _interp_has_deps(venv_py):
            steps.append({"step": "setup", "rc": 0, "ms": 0, "skipped": ".venv ready"})
        else:
            steps.append({"step": "setup"} | _run(
                [str(REPO_ROOT / "bin" / "setup")], timeout=900
            ))

    # 2. index fetch + runtime sidecar ensure
    if not args.skip_index:
        steps.append({"step": "index-fetch"} | _run(
            [sys.executable, str(REPO_ROOT / "bin" / "index-fetch")], timeout=120
        ))

    # 3. daemon start (background)
    if not args.skip_daemon:
        if _daemon_alive():
            steps.append({"step": "rag-daemon", "rc": 0, "ms": 0, "skipped": "alive"})
        else:
            log = Path("/tmp/paradigm-v2-daemon-bootstrap.log")
            steps.append({"step": "rag-daemon"} | _run(
                [sys.executable, str(REPO_ROOT / "bin" / "rag-daemon"),
                 "start-bg", "--log-path", str(log), "--timeout-s", "90"],
                timeout=95,
            ))

    success = all(s.get("rc") == 0 for s in steps)
    print(json.dumps({"steps": steps, "healthy": success},
                       ensure_ascii=False, indent=2))
    return 0 if success else 1


if __name__ == "__main__":
    raise SystemExit(main())
